---
import { Image } from "astro:assets";
import BedrockLogo from "../assets/bedrock.svg";
import LanguagePicker from "./LanguagePicker.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/demos", label: "Demos", match: "/demos" },
  { href: "/services", label: "Services", match: "/services" },
  { href: "/docs/getting-started", label: "Docs", match: "/docs" },
  { href: "/about", label: "About", match: "/about" },
];
const isActive = (match: string) =>
  pathname === match || pathname.startsWith(`${match}/`);
---

<nav class="navbar">
  <div class="navbar-container">
    <a href="/" class="logo">
      <Image src={BedrockLogo} width="24" alt="Bedrock.engineer logo" />
      <span class="logo-text">Bedrock.engineer</span>
    </a>

    <div class="nav-links">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.match) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Right side: Search + Theme Toggle + Language -->
    <div class="nav-actions">
      <Search />
      <ThemeToggle />
      <!-- <LanguagePicker /> -->
      <button
        type="button"
        class="hamburger"
        popovertarget="mobile-nav"
        aria-label="Open navigation menu"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 15 15"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M14 12.85L1 12.85L1 14.15L14 14.15L14 12.85ZM14 8.85002L1 8.85002L1 10.15L14 10.15L14 8.85002ZM1 4.85003L14 4.85003L14 6.15003L1 6.15002L1 4.85003ZM14 0.850025L1 0.850025L1 2.15002L14 2.15002L14 0.850025Z"
            fill="currentColor"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.match) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--gray-1);
    border-bottom: 1px solid var(--border-color-light);
  }

  .navbar-container {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-block: var(--space-xs);
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding-inline: var(--section-padding-inline);
    @media (max-width: 640px) {
      padding-inline: var(--section-padding-inline);
    }
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    column-gap: 8px;
    font-size: var(--text-xl);
    font-family: var(--font-condensed);
    color: var(--gray-12);
    text-decoration: none;
    white-space: nowrap;

    &:hover {
      color: var(--green-11);
    }

    &:focus-visible {
      outline: 2px solid var(--green-9);
      outline-offset: 2px;
      border-radius: var(--border-radius-sm);
    }

    @media (prefers-reduced-motion: no-preference) {
      transition: color 0.15s ease;
    }
  }

  /* Navigation Links */
  .nav-links {
    display: none;
    gap: 8px;
    margin-inline-start: auto;

    @media (min-width: 768px) {
      display: flex;
    }

    a {
      font-size: var(--text-base);
      color: var(--gray-11);
      text-decoration: none;
      white-space: nowrap;
      border-radius: var(--border-radius-sm);
      padding: var(--space-2xs) var(--space-xs);

      &:hover {
        color: var(--green-11);
        background: var(--gray-3);
      }

      &:active {
        background: var(--gray-4);
      }

      &:focus-visible {
        outline: 2px solid var(--green-9);
        outline-offset: 2px;
      }

      &[aria-current="page"] {
        color: var(--green-11);
        background: var(--gray-3);
        font-weight: 500;
      }

      @media (prefers-reduced-motion: no-preference) {
        transition:
          color 0.15s ease,
          background 0.15s ease;
      }
    }
  }

  /* Right side actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-inline-start: auto;

    @media (min-width: 768px) {
      margin-inline-start: 0;
    }
  }

  /* Hamburger button — only on narrow screens */
  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    color: var(--gray-11);
    border: 1px solid transparent;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    anchor-name: --hamburger;

    &:hover {
      color: var(--green-11);
      background: var(--gray-3);
    }

    &:focus-visible {
      outline: 2px solid var(--green-9);
      outline-offset: 2px;
    }

    @media (min-width: 768px) {
      display: none;
    }
  }

  /* Popover menu */
  .mobile-nav {
    margin: 0;
    padding: var(--space-xs);
    border: 1px solid var(--border-color-light);
    border-radius: var(--border-radius-md);
    background: var(--gray-1);
    box-shadow: var(--shadow-md, 0 8px 24px rgba(0, 0, 0, 0.12));
    min-width: 200px;

    /* Static fallback positioning */
    position: fixed;
    inset: auto;
    top: 3.5rem;
    right: var(--section-padding-inline);

    /* Anchor-positioned where supported */
    @supports (position-anchor: --x) {
      position-anchor: --hamburger;
      top: calc(anchor(bottom) + 4px);
      right: anchor(right);
    }

    a {
      display: block;
      font-size: var(--text-base);
      color: var(--gray-11);
      text-decoration: none;
      white-space: nowrap;
      border-radius: var(--border-radius-sm);
      padding: var(--space-xs) var(--space-s);

      &:hover {
        color: var(--green-11);
        background: var(--gray-3);
      }

      &:focus-visible {
        outline: 2px solid var(--green-9);
        outline-offset: 2px;
      }

      &[aria-current="page"] {
        color: var(--green-11);
        background: var(--gray-3);
        font-weight: 500;
      }
    }
  }

  .mobile-nav::backdrop {
    background: transparent;
  }
</style>
