---
import { Icon } from "@astrojs/starlight/components";
---

<footer class="footer">
  <div class="footer-wrapper">
    <div class="footer-content">
      <div class="footer-columns">
        <div class="footer-column">
          <h3 class="footer-title">Connect</h3>
          <ul>
            <li>
              <a
                class="footer-link"
                href="https://www.linkedin.com/company/bedrock-engineer/"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon class="footer-icon" name="linkedin" />
                LinkedIn
              </a>
            </li>
            <li>
              <a
                class="footer-link"
                href="https://github.com/bedrock-engineer/"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon class="footer-icon" name="github" />
                GitHub
              </a>
            </li>
            <li>
              <a class="footer-link" href="mailto:info@bedrock.engineer">
                <Icon class="footer-icon" name="email" />
                info@bedrock.engineer
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-title">Documentation</h3>
          <ul>
            <li>
              <a class="footer-link" href="docs/getting-started"
                >Getting Started with <code>bedrock-ge</code></a
              >
            </li>
            <li>
              <a class="footer-link" href="docs/guides/viewing-qgis/">Guides</a>
            </li>
            <li>
              <a class="footer-link" href="docs/examples/">Examples</a>
            </li>
            <li>
              <a class="footer-link" href="docs/reference/">API Reference</a>
            </li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-title">Company</h3>
          <ul>
            <li>
              <a class="footer-link" href="/about">About</a>
            </li>
            <li>
              <a class="footer-link" href="/services">Services</a>
            </li>
            <li>
              <a class="footer-link" href="/mission">Mission</a>
            </li>
            <li>
              <a class="footer-link" href="/voxels">3D Tiles Voxels</a>
            </li>
            <!-- <li>
              <a class="footer-link" href="/cases">Cases</a>
            </li> -->
            <li>
              <a class="footer-link" href="/technologies">Technologies</a>
            </li>
            <li>
              <a class="footer-link" href="/brand-assets">Brand Assets</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">
          © {new Date().getFullYear()} Bedrock Engineer B.V. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer is intentionally always dark — fixed tokens scoped here */
  .footer {
    --footer-bg: #111211;
    --footer-border: #181a18;
    --footer-text: #edeeed;
    --footer-text-muted: #b1b6b0;
    --footer-link: #b1b6b0;

    background-color: var(--footer-bg);
    font-size: var(--text-sm);
  }

  .footer-wrapper {
    max-width: var(--container-wide);
    background-image: url("/textures/granite.svg");
    margin-inline: auto;
    background-size: 150px;
    border-inline: 1px solid var(--footer-border);
  }

  .footer-content {
    padding-block: var(--section-padding-block);
    padding-inline: var(--section-padding-inline);
    border-inline: 1px solid var(--footer-border);
    max-width: var(--container-md);
    margin-inline: auto;
    background-color: var(--footer-bg);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-l);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    row-gap: var(--space-3xs);
  }

  .footer-column li {
    margin: 0;
  }

  .footer-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    background-color: var(--footer-bg);
    width: fit-content;
    margin-bottom: var(--space-s);
    color: var(--footer-text);
  }

  .footer-icon {
    display: inline;
    margin-right: var(--space-2xs);
    vertical-align: middle;
  }

  .footer-link {
    background-color: var(--footer-bg);
    color: var(--footer-link);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;

    &:hover {
      color: var(--footer-text);
      text-decoration: none;
    }
  }

  .footer-bottom {
    padding-top: 1.5rem;
  }

  .footer-copyright {
    width: fit-content;
    background-color: var(--footer-bg);
    color: var(--footer-text-muted);
    margin: 0;
    text-align: center;
    font-size: var(--text-sm);
  }
</style>
