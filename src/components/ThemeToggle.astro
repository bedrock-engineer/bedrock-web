---
// Triangle theme toggle - light/auto/dark
// Drop-in replacement for a standard theme toggle.
// Uses a rotating equilateral triangle indicator instead of a sliding pill.
import sunIcon from "./icons/sun.svg?raw";
import autoIcon from "./icons/auto.svg?raw";
import moonIcon from "./icons/moon.svg?raw";

const { class: className } = Astro.props;

function svgInner(raw: string): string {
  return raw
    .replace(/<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "")
    .trim();
}

function svgViewBox(raw: string): string {
  return raw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 15 15";
}

const length = 40 ;
const altitude = (Math.sqrt(3) / 2) * length; // ≈ 43.3
const iconSize = 12;
const iconX = length / 2 - iconSize / 2; // 17.5

const trianglePath = `M${length / 2} 0 L${length} ${altitude} L0 ${altitude} Z`;
---
<svg
  id="triangle-toggle"
  class={className}
  role="radiogroup"
  aria-label="Color theme"
  width={length * 2}
  height={altitude}
  fill="none"
  overflow="visible"
  xmlns="http://www.w3.org/2000/svg"
>
  <g
    class="tri-btn"
    data-theme="light"
    role="radio"
    tabindex="0"
    aria-label="Light"
    aria-checked="false"
  >
    <path d={trianglePath}  class="tri-bg"></path>
    <path d={trianglePath}  class="tri-focus-ring"></path>
    <svg
      x={iconX}
      y={altitude / 2}
      width={iconSize}
      height={iconSize}
      viewBox={svgViewBox(sunIcon)}
      class="tri-icon"
      set:html={svgInner(sunIcon)}
    />
  </g>

  <g
    class="tri-btn"
    role="radio"
    data-theme="auto"
    tabindex="-1"
    aria-label="Auto"
    aria-checked="false"
    transform={`translate(${length / 2}, 0)`}
  >
    <path d={trianglePath} class="tri-bg tri-inverted"></path>
    <path d={trianglePath} class="tri-focus-ring tri-inverted"></path>
    <svg
      x={iconX}
      y={iconSize / 2}
      width={iconSize}
      height={iconSize}
      viewBox={svgViewBox(autoIcon)}
      class="tri-icon"
      set:html={svgInner(autoIcon)}
    />
  </g>

  <g
    class="tri-btn"
    data-theme="dark"
    role="radio"
    tabindex="-1"
    aria-label="Dark"
    aria-checked="false"
    transform={`translate(${length}, 0)`}
  >
    <path d={trianglePath} class="tri-bg"></path>
    <path d={trianglePath} class="tri-focus-ring"></path>
    <svg
      x={iconX}
      y={altitude / 2}
      width={iconSize}
      height={iconSize}
      viewBox={svgViewBox(moonIcon)}
      class="tri-icon"
      set:html={svgInner(moonIcon)}
    />
  </g>

  <!-- Rotating indicator: same triangle, rotates 0°/60°/120° around its
       bottom-right corner to land on light/auto/dark positions -->
  <path id="tri-indicator" d={trianglePath} class="tri-indicator" stroke="none"
  ></path>
</svg>

<!-- is:inline so this runs synchronously during parsing, before first
     paint — a bundled module script runs after paint, so the indicator
     would visibly swing from its CSS default (light) to the real theme -->
<script is:inline>
  // Each step rotates 60° around the triangle's bottom-right corner,
  // landing exactly on the next triangle in the tiling.
  const rotations = { light: 0, auto: 60, dark: 120 };

  function getTheme() {
    const s = localStorage.getItem("theme");
    return s === "light" || s === "dark" || s === "auto" ? s : "auto";
  }

  function getResolvedTheme(theme) {
    return theme === "auto"
      ? window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light"
      : theme;
  }

  function getBtns() {
    return Array.from(
      document.querySelectorAll("#triangle-toggle .tri-btn"),
    );
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute(
      "data-theme",
      getResolvedTheme(theme),
    );
    localStorage.setItem("theme", theme);

    const indicator = document.getElementById("tri-indicator");
    if (indicator) indicator.style.transform = `rotate(${rotations[theme]}deg)`;

    getBtns().forEach((btn) => {
      const active = btn.dataset.theme === theme;
      btn.classList.toggle("active", active);
      btn.setAttribute("aria-checked", String(active));
      // Roving tabindex: only the selected radio is in the tab order
      btn.setAttribute("tabindex", active ? "0" : "-1");
    });
  }

  getBtns().forEach((btn) => {
    btn.addEventListener("click", () => applyTheme(btn.dataset.theme));
    btn.addEventListener("keydown", (e) => {
      const btns = getBtns();
      const idx = btns.indexOf(btn);
      if (e.key === " " || e.key === "Enter") {
        e.preventDefault();
        applyTheme(btn.dataset.theme);
      } else if (e.key === "ArrowRight" || e.key === "ArrowDown") {
        e.preventDefault();
        const next = btns[(idx + 1) % btns.length];
        applyTheme(next.dataset.theme);
        next.focus();
      } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
        e.preventDefault();
        const prev = btns[(idx - 1 + btns.length) % btns.length];
        applyTheme(prev.dataset.theme);
        prev.focus();
      }
    });
  });

  applyTheme(getTheme());

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (getTheme() === "auto") applyTheme("auto");
    });
</script>

<style>
  #triangle-toggle {
    display: block;
    cursor: default;
  }

  .tri-bg {
    fill: var(--gray-6);
    stroke: var(--gray-4);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* Inverts the center triangle to point downward */
  .tri-inverted {
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(180deg);
  }

  .tri-btn {
    cursor: pointer;
    outline: none;

    &:hover .tri-bg {
      fill: var(--gray-7);
    }

    &:focus-visible .tri-focus-ring {
      opacity: 1;
    }
  }

  .tri-focus-ring {
    fill: none;
    stroke: var(--green-9);
    stroke-width: 2;
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
  }

  .tri-icon {
    fill: var(--gray-12);
    opacity: 0.5;
    pointer-events: none;

    .tri-btn.active & {
      opacity: 1;
    }
  }

  .tri-indicator {
    fill: var(--green-a7);
    transform-box: fill-box;
    transform-origin: 100% 100%; /* bottom-right corner of the triangle */
    transform: rotate(0deg);
    pointer-events: none;

    @media (prefers-reduced-motion: no-preference) {
      transition: transform 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.1);
    }
  }
</style>
