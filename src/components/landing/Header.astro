---
import { Image } from "astro:assets";
import BedrockLogo from "../../assets/bedrock.svg";
import Button from "../Button.astro";
import { GeologicalModel } from "../model/block-model.jsx";
---

<header class="landing-section">
  <div class="py-2 mx-1 flex justify-end items-center">
    <code class="block font-mono text-sm text-right">
      <a href="https://pypi.org/project/bedrock-ge/"> uv add bedrock-ge </a>
    </code>
    <!-- TODO add copy button -->
  </div>

  <div class="main">
    <div>
      <h2 class="text-3xl md:text-4xl flex gap-2">
        <Image src={BedrockLogo} width="30" alt="Bedrock logo" class="block" />
        Bedrock
      </h2>
      <h1>
        Transform your ground investigation data from legacy databases and
        formats into <em>structured 3D geospatial</em> data
      </h1>

      <p>
        3D geospatial databases for ground investigation data are like USB-C for
        electronic devices.
      </p>

      <div class="flex flex-wrap space-between gap-2 my-6">
        <Button href="/getting-started" variant="primary">
          Start with <code>bedrock-ge</code>
        </Button>
        <Button href="/examples">Examples</Button>
        <Button href="/professional-support">Professional support</Button>
      </div>
    </div>

    <GeologicalModel client:load />
  </div>
</header>

<style>
  header {
    display: grid;
    grid-template-rows: min-content 1fr;
    min-height: min-content;
    background-image: url("/607.svg");
    background-size: 80px;
  }

  .main {
    display: grid;
    grid-template-columns: 1fr;
    place-content: center;
    padding-bottom: 16px;
  }

  @media (min-width: 1024px) {
    header {
      height: min(calc(100svh - 238px), 800px);
    }
    
    .main {
      grid-template-columns: 2fr 1fr;
    }
  }

  h1 {
    font-size: clamp(1.25rem, 0.954rem + 2.963vw, 3.25rem);
  }
</style>
