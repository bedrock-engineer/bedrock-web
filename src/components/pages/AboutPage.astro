---
import TeamMember from "../TeamMember.astro";
import joostImage from "../../assets/JoostGevaert.jpg";
import julesImage from "../../assets/JulesBlom.jpg";

interface Props {
  t: any; // translations object
}

const { t } = Astro.props;
---

<div class="page" data-pagefind-body data-pagefind-meta="category:Marketing">
  <header
    style="background: url('/textures/607.svg'); background-size: 70px;"
    class="section-wrapper"
  >
    <section class="section intro-section">
      <h1 class="heading-1" style="font-size: 36px;">{t.title}</h1>
      <p class="paragraph-xl">
        {t.intro}
      </p>
      <p style="margin-block-start: var(--space-m);">
        <span class="badge">{t.credential}</span>
      </p>
    </section>
  </header>

  <div
    style="background: url('/textures/232-K.svg'); background-size: 80px;"
    class="section-wrapper"
  >
    <section class="section">
      <TeamMember
        name="Joost Gevaert"
        image={joostImage}
        variant="expanded"
        socials={[
          {
            href: "https://www.linkedin.com/in/joost-gevaert/",
            label: "LinkedIn",
            icon: "linkedin",
          },
        ]}
      >
        <p>{t.joost.bio.p1}</p>
        <p>{t.joost.bio.p2}</p>
        <p>{t.joost.bio.p3}</p>
      </TeamMember>
    </section>
  </div>

  <div
    style="background: url('/textures/620.svg'); background-size: 100px;"
    class="section-wrapper"
  >
    <section class="section">
      <TeamMember
        name="Jules Blom"
        image={julesImage}
        variant="expanded"
        socials={[
          {
            href: "https://www.linkedin.com/in/crown-jules/",
            label: "LinkedIn",
            icon: "linkedin",
          },
          {
            href: "https://julesblom.com",
            label: "Website",
            icon: "external",
          },
        ]}
      >
        <p>{t.jules.bio.p1}</p>
        <ul>
          {t.jules.bio.beliefs.map((belief: string) => <li>{belief}</li>)}
        </ul>
        <p>{t.jules.bio.p2}</p>
        <p>{t.jules.bio.p3}</p>
        <p>{t.jules.bio.p4}</p>
      </TeamMember>
    </section>
  </div>

  <div class="section-wrapper">
    <section class="section">
      <h2 class="heading-2" style="margin-block-end: 24px;">Company Information</h2>
      <p class="paragraph" style="margin-block-end: 32px; color: var(--gray-11);">
        Legal details for invoicing and administration.
      </p>
      <dl class="details-list">
        <div>
          <dt class="details-term">Company name</dt>
          <dd class="details-value">Bedrock Engineer B.V.</dd>
        </div>
        <div>
          <dt class="details-term">VAT ID</dt>
          <dd class="details-value">NL868428681B01</dd>
        </div>
        <div>
          <dt class="details-term">KvK number</dt>
          <dd class="details-value">98282581</dd>
        </div>
      </dl>
    </section>
  </div>
</div>

<style>
  .details-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: var(--measure-narrow);
  }

  .details-term {
    font-weight: var(--font-semibold);
    color: var(--gray-11);
    font-size: var(--text-sm);
  }

  .details-value {
    font-size: var(--text-lg);
    color: var(--gray-12);
    font-family: var(--font-mono);
  }
</style>
