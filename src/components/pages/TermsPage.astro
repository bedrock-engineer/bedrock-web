---
interface Props {
  t: any; // translations object
}

const { t } = Astro.props;
---

<div class="page" data-pagefind-body data-pagefind-meta="category:Marketing">
  <header
    style="background: url('/textures/607.svg'); background-size: 70px;"
    class="section-wrapper"
  >
    <section class="section intro-section">
      <h1 class="heading-1" style="font-size: 36px;">{t.title}</h1>
      <p class="paragraph-xl">{t.intro}</p>
      <p class="language-note">
        {t.languageNote}{" "}
        <a class="language-link" href={t.otherVersionHref}
          >{t.otherVersionLabel}</a
        >
      </p>
    </section>
  </header>

  <div class="section-wrapper">
    <section class="section">
      <dl class="details-list">
        {
          t.details.map((detail: { term: string; value: string }) => (
            <div>
              <dt class="details-term">{detail.term}</dt>
              <dd class="details-value">{detail.value}</dd>
            </div>
          ))
        }
      </dl>

      <div
        class="terms-articles"
        style={`--article-label: "${t.articleLabel}"`}
      >
        {
          t.articles.map(
            (article: {
              title: string;
              clauses: (string | { text: string; items: string[] })[];
            }) => (
              <article class="terms-article">
                <h2 class="terms-article-title">{article.title}</h2>

                <ol class="terms-clauses">
                  {article.clauses.map((clause) => (
                    <li class="terms-clause">
                      {typeof clause === "string" ? clause : clause.text}
                      {typeof clause !== "string" && (
                        <ol class="terms-subclauses">
                          {clause.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ol>
                      )}
                    </li>
                  ))}
                </ol>
              </article>
            ),
          )
        }
      </div>
    </section>
  </div>
</div>

<style>
  .language-link {
    text-decoration: underline;
  }

  .details-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-block-end: var(--space-l);
  }

  .details-term {
    font-weight: var(--font-semibold);
    color: var(--gray-11);
    font-size: var(--text-sm);
  }

  .details-value {
    font-size: var(--text-base);
    color: var(--gray-12);
    font-family: var(--font-mono);
  }

  .language-note {
    font-size: var(--text-sm);
    color: var(--gray-11);
    font-style: italic;
    max-width: 70ch;
    margin-block-start: var(--space-xs);
  }

  .terms-articles {
    counter-reset: article;
  }

  .terms-article {
    counter-increment: article;
    margin-block-end: var(--space-xl);
  }

  .terms-article-title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    font-family: var(--font-condensed);
    margin-block-end: var(--space-s);

    &::before {
      content: var(--article-label) " " counter(article) ". ";
    }
  }

  .terms-clauses {
    counter-reset: clause;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .terms-clause {
    counter-increment: clause;
    display: grid;
    grid-template-columns: 3.5ch 1fr;
    gap: var(--space-2xs);
    max-width: 75ch;
    line-height: 1.6;

    &::before {
      content: counter(article) "." counter(clause);
      font-weight: var(--font-semibold);
      color: var(--gray-11);
      font-variant-numeric: tabular-nums;
    }
  }

  .terms-subclauses {
    grid-column: 2;
    list-style: lower-alpha;
    margin: 0;
    padding-inline-start: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    & ::marker {
      font-weight: var(--font-semibold);
      color: var(--gray-11);
    }
  }

  @media print {
    .terms-article {
      break-inside: avoid;
    }
  }
</style>

<style is:global>
  @media print {
    nav,
    footer,
    .navbar,
    .footer {
      display: none !important;
    }
  }
</style>
