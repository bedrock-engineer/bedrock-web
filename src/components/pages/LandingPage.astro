    </section>
  </div>

  <div class="section-wrapper texture-232-k">
    <section class="section tabs-section">
      <AnimatedDemoTabs client:load t={t.demoTabs} />

      <div class="section-link-center">
        <a href="/demos" class="section-link">
          {t.demos.exploreAll} →
        </a>
      </div>
    </section>
  </div>

  <div class="section-wrapper texture-616">
    <section class="section">
      <a href="/voxels" class="voxel-callout">
        <Image
          src={geotopSouthHolland}
          alt={t.voxels.imageAlt}
          class="voxel-callout-image"
        />
        <div class="voxel-callout-text">
          <h2 class="heading-3">{t.voxels.heading}</h2>
          <p>{t.voxels.body}</p>
          <span class="cesium-badge">{t.voxels.badge}</span>
          <span class="section-link">{t.voxels.link} →</span>
        </div>
      </a>
    </section>
  </div>

  <div class="section-wrapper texture-607">
    <section class="section">
      <h2 class="heading-2 anchor-heading" id="what-we-do">
        {t.whatWeDo.heading}
        <a class="anchor-link" href="#what-we-do">#</a>
      </h2>

      <div class="grid-auto-fit gap-y-8">
        <div>
          <p class="paragraph" style="margin-block-end: var(--space-m)">
            {t.whatWeDo.intro}
          </p>

          <h3 class="heading-4">{t.whatWeDo.subheading}</h3>
          <ul class="services-list paragraph">
            {t.whatWeDo.items.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>

        <HoverLogo class="place-self-center" />
      </div>

      <div class="section-link-center">
        <a href="/services" class="section-link"> {t.whatWeDo.link} → </a>
      </div>
    </section>
  </div>

  <div class="section-wrapper texture-616">
    <section class="section">
      <h2 class="heading-2 anchor-heading" id="values">
        {t.values.heading} <a class="anchor-link" href="#values">#</a>
      </h2>

      <div class="grid-auto-fit" style="--grid-gap: 72px;">
        <div class="value-card">
          <h3 class="value-title text-xl font-semibold">
            {t.values.purposeBuilt.title}
          </h3>
          <p>{t.values.purposeBuilt.body}</p>
        </div>

        <div class="value-card">
          <h3 class="value-title text-xl font-semibold">
            {t.values.standardFormats.title}
          </h3>
          <p>{t.values.standardFormats.body}</p>
        </div>

        <div class="value-card">
          <h3 class="value-title text-xl font-semibold">
            {t.values.openEcosystems.title}
          </h3>
          <p>
            {t.values.openEcosystems.bodyBefore}<code
              ><a href="/docs/cpt-anywidget/">cpt-anywidget</a></code
            >{t.values.openEcosystems.middle}<code
              ><a href="https://github.com/bedrock-engineer/symeval"
                >symeval</a
              ></code
            >{t.values.openEcosystems.bodyAfter}
          </p>
        </div>
      </div>

      <div class="section-link-center">
        <a href="/mission" class="section-link"> {t.values.link} → </a>
      </div>
    </section>
  </div>

  <div class="section-wrapper texture-668">
    <section class="section team" style="--grid-color: black;">
      <h2 class="heading-2 anchor-heading" id="team">
        {t.team.heading} <a class="anchor-link" href="#team">#</a>
      </h2>

      <div class="team-member-grid">
        <Card class="team-member card">
          <h3>{t.team.jules.name}</h3>
          <Image src={jules} alt={t.team.jules.name} style="filter: grayscale(1);" />
          <p>{t.team.jules.bio}</p>
        </Card>

        <Card class="team-member card">
          <h3>{t.team.joost.name}</h3>
          <Image
            src={joost}
            alt={t.team.joost.name}
            style="filter: grayscale(1);"
          />
          <p>{t.team.joost.bio}</p>
        </Card>
      </div>

      <div class="section-link-center">
        <a href="/about" class="section-link">{t.team.link} →</a>
      </div>
    </section>
  </div>

  <Footer />
</div>

<style>
  @reference "../../styles/custom.css";

  .paragraph {
    max-width: 50ch;
  }

  .section-link-center {
    margin-block-start: var(--space-l);
    text-align: center;
  }

  /* Alternate background colors for sections */
  .section-wrapper:nth-child(even) .section {
    background: var(--brown-1);
  }

  .section-wrapper:nth-child(odd) .section {
    background: var(--gray-1);
  }

  .hero-wrapper {
    padding-inline: var(--space-s);
    border-bottom: 1px solid var(--border-color);
    @media (max-width: 640px) {
      padding-inline: var(--space-2xs);
    }
  }

  .hero {
    margin-top: 12px;
    min-height: 620px;
    max-width: var(--container-wide);
    padding-block: 16px;
    margin-inline: auto;
    border-radius: 16px;
    text-align: center;
    color: white;
    background:
      linear-gradient(
        to bottom,
        oklch(10% 0.04244 152.546 / 0.6) 20%,
        oklch(14% 0.0086 134.306 / 0.95) 100%
      ),
      url("/ASCII-landscape.webp");
    background-size: cover;

    background-position: center;
    position: relative;
    display: grid;
    place-content: center;

    & > * {
      margin-inline: auto;
    }

    & h1 {
      font-size: clamp(1.8rem, 1.75rem + 2.4vw, 4rem);
      margin-top: var(--space-l);
      margin-bottom: var(--space-s);
      font-family: var(--font-condensed);
      text-box-trim: trim-both;
      text-wrap: balance;
    }

    & p {
      max-width: 50ch;
      text-align: center;
    }
  }

  .worked-with {
    border-top: none;
    padding-block-start: var(--space-l);
    padding-block-end: var(--space-xl);

    & h2 {
      font-size: var(--text-xl);
      color: var(--gray-10);
      text-align: center;
      margin-inline: auto;
      margin-bottom: var(--space-m-l);
    }
  }

  .header-controls {
    position: fixed;
    top: 16px;
    right: 24px;
    display: flex;
    flex-direction: row;
    align-items: end;
    gap: 4px;

    @media (max-width: 768px) {
      right: 12px;
      flex-direction: column-reverse;
    }
  }

  .logo-text {
    display: flex;
    align-items: center;
    justify-content: center;
    column-gap: 9px;
    font-size: 36px;
    font-family: var(--font-condensed);
    position: absolute;
    top: var(--space-s);
    left: 20px;

    @media (max-width: 640px) {
      font-size: 24px;
      column-gap: 6px;
      left: var(--space-xs);

      & svg {
        width: 28px;
        height: 31px;
      }
    }
  }

  .client-logos {
    display: flex;
    column-gap: var(--space-2xl);
    row-gap: var(--space-xl);
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;

    img {
      height: 48px;
      object-fit: contain;
    }
  }

  .team-member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-s);
    container-type: inline-size;
    container-name: team-grid;
  }

  .team-member {
    display: grid;
    grid-template-areas:
      "image description"
      "name description";
    column-gap: var(--space-m);
    row-gap: var(--space-xs);
    padding-block: var(--space-s);
    padding-inline: var(--space-l);

    & img {
      grid-area: image;
      min-width: 100px;
      max-width: min(220px, 100%);
      border-radius: 100%;
    }

    & h3 {
      grid-area: name;
      font-size: 1.25em;
      text-align: center;
    }

    & p {
      min-width: 20ch;
      grid-area: description;
    }
  }

  @container team-grid (width < 80ch) {
    .team-member {
      grid-template-areas:
        "image"
        "name"
        "description";
      justify-items: center;
    }
  }

  .tabs-section {
    padding-block-start: 0;
  }

  .voxel-callout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    align-items: center;
    text-decoration: none;
    color: inherit;
    border-radius: var(--border-radius);
    transition: background 0.15s;

    &:hover {
      background: var(--gray-2);
    }

    &:hover .section-link {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .voxel-callout-image {
