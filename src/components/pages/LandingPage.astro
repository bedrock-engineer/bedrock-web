---
import Image from "astro/components/Image.astro";
import Search from "@astrojs/starlight/components/Search.astro";

import bedrockLogo from "../../assets/bedrock.svg";
import joost from "../../assets/JoostGevaert.jpg";
import jules from "../../assets/JulesBlom.jpg";
import geotopSouthHolland from "../../assets/geotop-south-holland.png";

import { AnimatedDemoTabs } from "../AnimatedDemoTabs";
import Footer from "../Footer.astro";
import TeamMember from "../TeamMember.astro";
import HoverLogo from "../HoverLogo.astro";
import LanguagePicker from "../LanguagePicker.astro";
import ThemeToggle from "../ThemeToggle.astro";
import WorkedWith from "../WorkedWith.astro";
import "../../styles/custom.css";

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<div class="page">
  <div class="hero-wrapper">
    <header class="hero">
      <div class="logo-text">
        <Image src={bedrockLogo} width="42" height="46" alt="" />
        <span>Bedrock.engineer</span>
      </div>

      <h1 id="hero-heading">{t.hero.heading}</h1>

      <p class="md:text-lg">{t.hero.subhead}</p>

      <div
        class="mbs-12 flex max-w-full flex-col items-stretch gap-4 text-center sm:flex-row sm:flex-wrap sm:items-center sm:justify-center"
      >
        <a
          href="https://cal.com/bedrock.engineer"
          class="cta-button-inverted"
          target="_blank"
        >
          {t.hero.ctaPrimary}
        </a>
        <a href="/demos" class="cta-button-secondary-inverted"
          >{t.hero.ctaSecondary}</a
        >
      </div>
    </header>

    <div class="header-controls">
      <Search />
      <ThemeToggle />
      <LanguagePicker />
    </div>

    <WorkedWith t={t.workedWith} />
  </div>

  <div class="section-wrapper texture-232-k">
    <section class="section tabs-section">
      <AnimatedDemoTabs client:load t={t.demoTabs} />

      <div class="section-link-center">
        <a href="/demos" class="section-link">
          {t.demos.exploreAll} →
        </a>
      </div>
    </section>
  </div>

  <div class="section-wrapper texture-616">
    <section class="section">
      <a href="/voxels" class="voxel-callout">
        <Image
          src={geotopSouthHolland}
          alt={t.voxels.imageAlt}
          class="voxel-callout-image"
        />
        <div class="voxel-callout-text">
          <h2 class="heading-3">{t.voxels.heading}</h2>
          <p>{t.voxels.body}</p>
          <span class="badge">{t.voxels.badge}</span>
          <span class="section-link">{t.voxels.link} →</span>
        </div>
      </a>
    </section>
  </div>

  <div class="section-wrapper texture-607">
    <section class="section">
      <h2 class="heading-2 anchor-heading" id="what-we-do">
        {t.whatWeDo.heading}
        <a class="anchor-link" href="#what-we-do">#</a>
      </h2>

      <div class="grid-auto-fit gap-y-8">
        <div>
          <p class="paragraph" style="margin-block-end: var(--space-m)">
            {t.whatWeDo.intro}
          </p>

          <h3 class="heading-4">{t.whatWeDo.subheading}</h3>
          <ul class="services-list paragraph">
            {t.whatWeDo.items.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>

        <HoverLogo class="place-self-center" labels={t.whatWeDo.logoLayers} />
      </div>

      <div class="section-link-center">
        <a href="/services" class="section-link"> {t.whatWeDo.link} → </a>
      </div>
    </section>
  </div>

  <div class="section-wrapper texture-616">
    <section class="section">
      <h2 class="heading-2 anchor-heading" id="values">
        {t.values.heading}
        <a class="anchor-link" href="#values">#</a>
      </h2>

      <div class="grid-auto-fit" style="--grid-gap: 72px;">
        <div class="value-card">
          <h3 class="value-title text-xl font-semibold">
            {t.values.purposeBuilt.title}
          </h3>
          <p>{t.values.purposeBuilt.body}</p>
        </div>

        <div class="value-card">
          <h3 class="value-title text-xl font-semibold">
            {t.values.standardFormats.title}
          </h3>
          <p>{t.values.standardFormats.body}</p>
        </div>

        <div class="value-card">
          <h3 class="value-title text-xl font-semibold">
            {t.values.openEcosystems.title}
          </h3>
          <p>
            {t.values.openEcosystems.bodyBefore}<code
              ><a href="/docs/cpt-anywidget/">cpt-anywidget</a></code
            >{t.values.openEcosystems.middle}<code
              ><a href="https://github.com/bedrock-engineer/symeval">symeval</a
              ></code
            >{t.values.openEcosystems.bodyAfter}
          </p>
        </div>
      </div>

      <div class="section-link-center">
        <a href="/mission" class="section-link"> {t.values.link} → </a>
      </div>
    </section>
  </div>

  <div class="section-wrapper texture-668">
    <section class="section team" style="--grid-color: black;">
      <h2 class="heading-2 anchor-heading" id="team">
        {t.team.heading}
        <a class="anchor-link" href="#team">#</a>
      </h2>

      <div class="team-member-grid">
        <TeamMember name={t.team.jules.name} image={jules} variant="compact">
          {t.team.jules.bio}
        </TeamMember>

        <TeamMember name={t.team.joost.name} image={joost} variant="compact">
          {t.team.joost.bio}
        </TeamMember>
      </div>

      <div class="section-link-center">
        <a href="/about" class="section-link">{t.team.link} →</a>
      </div>
    </section>
  </div>

  <Footer />
</div>

<style>
  @reference "../../styles/custom.css";

  /* body is a grid, making .page a grid item whose default min-width: auto
     turns the demo tabs' intrinsic width into a page-wide floor — forcing
     horizontal overflow on phones */
  .page {
    min-width: 0;
  }

  .section-link-center {
    margin-block-start: var(--space-l);
    text-align: center;
  }

  /* Alternate background colors for sections */
  .section-wrapper:nth-child(even) .section {
    background: var(--brown-1);
  }

  .section-wrapper:nth-child(odd) .section {
    background: var(--gray-1);
  }

  .hero-wrapper {
    /* 0.5rem on phones up to 1.25rem on desktop, in place of a breakpoint */
    padding-inline: clamp(0.5rem, -0.1rem + 1.5vw, 1.25rem);
    border-block-end: 1px solid var(--color-border);
  }

  .hero {
    margin-block-start: var(--space-xs);
    min-height: 620px;
    max-width: var(--container-wide);
    padding-block: var(--space-s);
    padding-inline: var(--space-m);
    margin-inline: auto;
    border-radius: var(--border-radius-lg);
    text-align: center;
    color: white;
    background:
      linear-gradient(
        to bottom,
        oklch(10% 0.04244 152.546 / 0.6) 20%,
        oklch(14% 0.0086 134.306 / 0.95) 100%
      ),
      url("/ASCII-landscape.webp");
    background-size: cover;

    background-position: center;
    position: relative;
    display: grid;
    place-content: center;

    & > * {
      margin-inline: auto;
    }

    & h1 {
      font-size: var(--heading-display);
      margin-block-start: var(--space-l);
      margin-block-end: var(--space-s);
      font-family: var(--font-condensed);
      text-box-trim: trim-both;
      text-wrap: balance;
    }

    & p {
      max-width: var(--measure);
      text-align: center;
    }
  }

  .header-controls {
    position: fixed;
    inset-block-start: 16px;
    inset-inline-end: 24px;
    display: flex;
    flex-direction: row;
    align-items: end;
    gap: 4px;

    @media (max-width: 768px) {
      inset-inline-end: 12px;
      flex-direction: column-reverse;
    }
  }

  .logo-text {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Gap and logo size in em so they track the fluid font size (9px gap and
       46px logo at 36px font; 6px and 31px at 24px) */
    column-gap: 0.25em;
    /* 24px on phones up to 36px from ~1024px wide */
    font-size: clamp(1.5rem, 0.25rem + 3.125vw, 2.25rem);
    font-family: var(--font-condensed);
    position: absolute;
    inset-block-start: var(--space-s);
    inset-inline-start: clamp(0.75rem, 0.2rem + 1.4vw, 1.25rem);

    & img {
      width: auto;
      height: 1.28em;
    }
  }

  .team-member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-s);
    container-type: inline-size;
    container-name: team-grid;
  }

  .tabs-section {
    padding-block-start: 0;
  }

  .voxel-callout {
    display: grid;
    /* Two equal columns that stack on their own when each would drop under
       ~22rem, in place of a breakpoint */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-l);
    align-items: center;
    text-decoration: none;
    color: inherit;
    border-radius: var(--border-radius-md);
    transition: background var(--duration-fast) var(--ease-out);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        background: var(--gray-2);
      }

      &:hover .section-link {
        text-decoration: underline;
      }
    }

    &:active {
      background: var(--gray-3);
    }
  }

  .voxel-callout-image {
    border-radius: var(--border-radius-sm);
    width: 80%;
    height: auto;
  }

  .voxel-callout-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);

    & p {
      line-height: var(--leading-relaxed);
      max-width: var(--measure-narrow);
    }
  }

  /* Keep the shared .badge from stretching in the flex column. */
  .voxel-callout-text :global(.badge) {
    align-self: flex-start;
  }

  .services-list {
    list-style: none;
    padding-inline-start: 0;

    li {
      padding-inline-start: var(--space-m);
      margin-block: var(--space-xs);
      position: relative;

      &::before {
        content: "→";
        position: absolute;
        inset-inline-start: 0;
        color: var(--green-8);
        font-weight: bold;
      }
    }
  }

  /* .values-grid replaced with .grid-auto-fit-narrow from global CSS */

  .value-card {
    @apply flex flex-col gap-x-8 gap-y-4;
    & p {
      flex-grow: 1;
      line-height: var(--leading-relaxed);
      max-width: var(--measure-narrow);
    }

    & code {
      background: var(--gray-3);
      padding: 2px 6px;
      border-radius: var(--border-radius-sm);
      font-size: 0.9em;
    }
  }

  /* On an h3, so the condensed family comes from the global heading styles */
  .value-title {
    color: var(--color-text);
  }
</style>

<style is:global>
  /* Override Search button to stay icon-only (not expand to a search bar) */
  .header-controls button[data-open-modal] {
    background: var(--gray-6) !important;
    border: 1px solid var(--gray-4) !important;
    border-radius: var(--border-radius-sm) !important;
    color: var(--gray-12) !important;
    width: 36px !important;
    max-width: none !important;
    height: 36px !important;
    padding: 0 !important;
    justify-content: center !important;
  }
  @media (hover: hover) and (pointer: fine) {
    .header-controls button[data-open-modal]:hover {
      background: var(--gray-7) !important;
    }
  }
  /* Hide the text label and keyboard shortcut */
  .header-controls button[data-open-modal] span,
  .header-controls button[data-open-modal] kbd {
    display: none !important;
  }
  /* Remove the ThemeToggle's built-in top margin so it aligns in the flex row */
  .header-controls #triangle-toggle {
    margin-block-start: 0;
  }
  /* Center the search dialog on the landing page (Starlight defaults to top-aligned) */
  .header-controls dialog {
    margin: auto;
  }
</style>
