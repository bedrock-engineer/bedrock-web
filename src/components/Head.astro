---
import StarlightHead from "@astrojs/starlight/components/Head.astro";

// This component extends Starlight's default Head with custom OG images
const { pathname } = Astro.url;
const isDocPage =
  pathname.startsWith("/guides/") ||
  pathname.startsWith("/explanation/") ||
  pathname.startsWith("/reference/");

const ogImageUrl = isDocPage
  ? new URL(pathname + "og.png", Astro.site).toString()
  : new URL("/og-default.png", Astro.site).toString();
---

<StarlightHead {...Astro.props} />

{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
