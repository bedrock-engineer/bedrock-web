---
import { languages, defaultLang } from "../i18n/ui";
import { getLocaleFromUrl, getLocalizedPath } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Remove locale prefix to get base path
const basePath = locale === defaultLang
  ? currentPath
  : currentPath.replace(`/${locale}`, "") || "/";
---

<div class="language-picker">
  {Object.entries(languages).map(([lang, label]) => {
    const href = getLocalizedPath(basePath, lang as keyof typeof languages);
    const isActive = lang === locale;

    return (
      <a
        href={href}
        class:list={["lang-link", { active: isActive }]}
        aria-current={isActive ? "page" : undefined}
      >
        {lang.toUpperCase()}
      </a>
    );
  })}
</div>

<script is:inline>
  // Hide the page until the scroll position below is restored, so the top doesn't flash first.
  // The timeout is a fallback in case the restore script never runs.
  try {
    if (sessionStorage.getItem("lang-switch-scroll") !== null && !location.hash) {
      document.documentElement.style.visibility = "hidden";
      setTimeout(() => (document.documentElement.style.visibility = ""), 1000);
    }
  } catch {}
</script>

<script>
  // Switching language is a full page load, so carry the scroll position over.
  // Stored as a fraction of the scrollable height since translations differ in length.
  const KEY = "lang-switch-scroll";

  const saved = sessionStorage.getItem(KEY);
  if (saved !== null) {
    sessionStorage.removeItem(KEY);
    const max = document.documentElement.scrollHeight - innerHeight;
    if (!location.hash) scrollTo({ top: Number(saved) * max, behavior: "instant" });
    document.documentElement.style.visibility = "";
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>(".lang-link:not(.active)")) {
    link.addEventListener("click", () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      sessionStorage.setItem(KEY, String(max > 0 ? scrollY / max : 0));
    });
  }
</script>

<style>
  .language-picker {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .lang-link {
    padding: var(--space-2xs) var(--space-xs);
    line-height: 1;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    border-radius: var(--border-radius-sm);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        color: var(--color-primary-text);
        background: var(--color-surface-overlay);
      }
    }

    &:active {
      background: var(--gray-4);
    }

    &:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }

    &.active {
      color: var(--color-primary-text);
      background: var(--color-surface-overlay);
      font-weight: 500;
    }

    @media (prefers-reduced-motion: no-preference) {
      transition:
        color var(--duration-fast) var(--ease-out),
        background var(--duration-fast) var(--ease-out);
    }
  }
</style>
