---
import { languages, defaultLang } from "../i18n/ui";
import { getLocaleFromUrl, getLocalizedPath } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Remove locale prefix to get base path
const basePath = locale === defaultLang
  ? currentPath
  : currentPath.replace(`/${locale}`, "") || "/";
---

<div class="language-picker">
  {Object.entries(languages).map(([lang, label]) => {
    const href = getLocalizedPath(basePath, lang as keyof typeof languages);
    const isActive = lang === locale;

    return (
      <a
        href={href}
        class:list={["lang-link", { active: isActive }]}
        aria-current={isActive ? "page" : undefined}
      >
        {lang.toUpperCase()}
      </a>
    );
  })}
</div>

<style>
  .language-picker {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .lang-link {
    padding: var(--space-2xs) var(--space-xs);
    line-height: 1;
    text-decoration: none;
    color: var(--gray-11);
    font-size: var(--text-sm);
    border-radius: var(--border-radius-sm);

    &:hover {
      color: var(--green-11);
      background: var(--gray-3);
    }

    &:active {
      background: var(--gray-4);
    }

    &:focus-visible {
      outline: 2px solid var(--green-9);
      outline-offset: 2px;
    }

    &.active {
      color: var(--green-11);
      background: var(--gray-3);
      font-weight: 500;
    }

    @media (prefers-reduced-motion: no-preference) {
      transition:
        color 0.15s ease,
        background 0.15s ease;
    }
  }
</style>
