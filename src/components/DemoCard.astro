---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Link from './Link.astro';

export interface Props {
  id?: string;
  title: string;
  description?: string;
  href?: string;
  linkText?: string;
  links?: { href: string; label: string; detail?: string }[];
  iframe?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  badge?: string;
  class?: string;
  country?: string;
  type?: string[];
  sourceData?: string[];
  gm?: string[];
}

const {
  id,
  title,
  description,
  href,
  linkText,
  links,
  iframe,
  image,
  imageAlt,
  badge,
  class: className,
  country,
  type,
  sourceData,
  gm,
} = Astro.props;

const tagAttrs = id
  ? {
      'data-demo-id': id,
      'data-country': country ?? '',
      'data-type': (type ?? []).join(','),
      'data-source-data': (sourceData ?? []).join(','),
      'data-gm': (gm ?? []).join(','),
      style: `view-transition-name: demo-${id};`,
    }
  : {};

// The same tags the filter bar on /demos filters on, in its order, minus those a link already
// shows as its subtitle, e.g. GIS and BIM on a card with both a CesiumJS and a Speckle demo
const allTags = new Set([
  country,
  ...(type ?? []),
  ...(sourceData ?? []),
  ...(gm ?? []),
]);
const linkDetails = new Set((links ?? []).map((link) => link.detail));
const tags = [...allTags].filter(
  (tag): tag is string => Boolean(tag) && !linkDetails.has(tag),
);

// The main link and any extra links share one stack, so they are spaced alike on every card
const allLinks: NonNullable<Props['links']> = [
  ...(href && linkText ? [{ href, label: linkText }] : []),
  ...(links ?? []),
];
---

<div class={`demo-card card-surface ${className || ''}`} {...tagAttrs}>
  <div class="demo-card-media">
    {badge && <span class="demo-card-badge badge" data-variant="solid">{badge}</span>}
    {
      iframe ? (
        <iframe
          src={iframe}
          class="demo-iframe"
          title={title}
        />
      ) : image ? (
        href ? (
          <a href={href} target="_blank" rel="noopener noreferrer">
            <Image src={image} alt={imageAlt || title} class="demo-image" />
          </a>
        ) : (
          <Image src={image} alt={imageAlt || title} class="demo-image" />
        )
      ) : null
    }
  </div>
  <div class="demo-card-content">
    <h3 class="demo-card-title">{title}</h3>
    {description && <p class="demo-card-description">{description}</p>}
    {
      tags.length > 0 && (
        <ul class="demo-card-tags" aria-label="Tags">
          {tags.map((tag) => (
            <li class="demo-card-tag">{tag}</li>
          ))}
        </ul>
      )
    }
    {
      allLinks.length > 0 && (
        <div class="demo-card-links">
          {allLinks.map((link) => (
            <Link href={link.href} variant="arrow">
              {link.label}
              {link.detail && (
                <span class="demo-card-link-detail">
                  {allTags.has(link.detail) ? (
                    <span class="demo-card-tag">{link.detail}</span>
                  ) : (
                    link.detail
                  )}
                </span>
              )}
            </Link>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .demo-card {
    /* Base surface (flex column, background, border) comes from the global
       .card-surface class */
    border-radius: var(--border-radius-md);
    overflow: hidden;

    @media (prefers-reduced-motion: no-preference) {
      transition: border-color var(--duration-normal) ease;
    }

    &:hover {
      border-color: var(--green-7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-card {
      view-transition-name: none !important;
    }
  }

  .demo-card-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--gray-3);
    position: relative;
  }

  /* Positioning only — pill styling comes from the global .badge utility. */
  .demo-card-badge {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    z-index: 1;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .demo-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .demo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

    @media (prefers-reduced-motion: no-preference) {
      transition: transform var(--duration-slow) ease;
    }

    &:hover {
      transform: scale(1.05);
    }
  }

  .demo-card-content {
    padding: var(--card-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex-grow: 1;
  }

  .demo-card-title {
    font-size: var(--heading-4);
    font-weight: var(--font-semibold);
    font-family: var(--font-condensed);
    color: var(--gray-12);
    margin: 0;
  }

  .demo-card-description {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--gray-12);
    flex-grow: 1;
    margin: 0;
  }

  /* Static versions of the filter chips on /demos */
  .demo-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .demo-card-tag {
    display: inline-block;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    padding: 1px 8px;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--gray-11);
  }

  .demo-card-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);

    /* Wrap the subtitle onto its own row after the arrow; the hover rule repeats the zero row gap
       because Link widens its gap on hover */
    & :global(.link[data-variant="arrow"]),
    & :global(.link[data-variant="arrow"]:hover) {
      flex-wrap: wrap;
      row-gap: 0;
    }
  }

  .demo-card-link-detail {
    order: 1;
    flex-basis: 100%;
    font-size: var(--text-sm);
    font-weight: normal;
    line-height: var(--leading-snug);
    color: var(--gray-11);
  }
</style>
