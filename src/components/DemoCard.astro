---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Link from './Link.astro';

export interface Props {
  title: string;
  href?: string;
  linkText?: string;
  iframe?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  class?: string;
}

const {
  title,
  href,
  linkText,
  iframe,
  image,
  imageAlt,
  class: className,
} = Astro.props;
---

<div class={`demo-card ${className || ''}`}>
  <div class="demo-card-media">
    {
      iframe ? (
        <iframe
          src={iframe}
          class="demo-iframe"
          title={title}
        />
      ) : image ? (
        href ? (
          <a href={href} target="_blank" rel="noopener noreferrer">
            <Image src={image} alt={imageAlt || title} class="demo-image" />
          </a>
        ) : (
          <Image src={image} alt={imageAlt || title} class="demo-image" />
        )
      ) : null
    }
  </div>
  <div class="demo-card-content">
    <h3 class="demo-card-title">{title}</h3>
    <div class="demo-card-description">
      <slot name="description" />
    </div>
    {
      href && linkText && (
        <Link href={href} variant="arrow" class="demo-link">
          {linkText}
        </Link>
      )
    }
    <slot />
  </div>
</div>

<style>
  .demo-card {
    display: flex;
    flex-direction: column;
    background: var(--gray-2);
    border: 1px solid var(--border-color-light);
    border-radius: 8px;
    overflow: hidden;

    @media (prefers-reduced-motion: no-preference) {
      transition: border-color 0.2s ease;
    }

    &:hover {
      border-color: var(--green-7);
    }
  }

  .demo-card-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--gray-3);
    position: relative;
  }

  .demo-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .demo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

    @media (prefers-reduced-motion: no-preference) {
      transition: transform 0.3s ease;
    }

    &:hover {
      transform: scale(1.05);
    }
  }

  .demo-card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .demo-card-title {
    font-size: 20px;
    font-weight: 600;
    font-family: 'IBM Plex Sans Condensed';
    color: var(--gray-12);
    margin: 0;
  }

  .demo-card-description {
    font-size: 16px;
    line-height: 1.5;
    color: var(--gray-12);
    flex-grow: 1;
  }

  .demo-card-description :global(p) {
    margin: 0;
  }

  .demo-card-description :global(p:not(:last-child)) {
    margin-bottom: 0.75em;
  }

  :global(.demo-card .demo-link) {
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .demo-card-content {
      padding: 20px;
    }
  }
</style>
