---
export interface Props {
  href?: string;
  variant?: 'default' | 'primary';
}

const { href, variant = 'default', ...props } = Astro.props;

const baseClasses = "px-2 py-1 w-fit rounded-[1px] border block transition-colors";
const variantClasses = {
  default: "bg-white border-black hover:bg-green-50 hover:border-green-600",
  primary: "bg-black border-black text-white hover:bg-gray-800"
};
---

{href ? (
  <a href={href} class={`${baseClasses} ${variantClasses[variant]}`} {...props}>
    <slot />
  </a>
) : (
  <button class={`${baseClasses} ${variantClasses[variant]}`} {...props}>
    <slot />
  </button>
)}
