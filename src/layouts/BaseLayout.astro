---
const {
  title = "Bedrock.engineer - Geotechnical & Subsurface Data Consulting Services",
  description = "Bedrock.engineer provides consulting and open-source software to visualize and integrate geotechnical data with BIM, Python, parametric design, and geospatial tools.",
  // Pages that supply their own og:image (via the "head" slot) set this to
  // suppress the default below and avoid emitting two og:image tags.
  customOgImage = false,
} = Astro.props;

const ogImageUrl = new URL("/og-default.png", Astro.site).toString();

const htmlDataAttributes: DOMStringMap = { "data-theme": "dark" };

import ThemeProvider from "@astrojs/starlight/components/ThemeProvider.astro";

import "../styles/starlight-search.css"; // CSS layers + utility classes for Starlight Search component
import "../styles/custom.css"; // fonts + design tokens loaded here
---

<html {...htmlDataAttributes} lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#63805E" />
    <!-- <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="hsl(60, 3%, 7%)"
    /> -->
    <title>{title}</title>
    <meta name="format-detection" content="telephone=no" />

    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    {
      !customOgImage && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content="Bedrock.engineer - Consulting for Subsurface Data & Open-Source Tools"
          />
        </>
      )
    }
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bedrock.engineer" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/bedrock.svg" />

    <script
      id="counterscale-script"
      data-site-id="bedrock-engineer"
      src="https://counterscale.jhngevaert.workers.dev.workers.dev/tracker.js"
      defer></script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Bedrock.engineer",
        "url": "https://bedrock.engineer",
        "logo": "https://bedrock.engineer/bedrock.svg",
        "description": "Software consultancy for transforming ground investigation data into structured, standardized geospatial data"
      }
    </script>

    <!-- Allow pages to inject additional head content -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
