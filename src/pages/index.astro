---
import joost from "../assets/JoostGevaert.jpg";
import jules from "../assets/JulesBlom.jpg";

import Image from "astro/components/Image.astro";
// import fugroLogo from "../assets/logos/fugro.svg";
import { AnimatedDemoTabs } from "../components/AnimatedDemoTabs";
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import HoverLogo from "../components/HoverLogo.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/custom.css";
---

<BaseLayout>
  <div class="page">
    <div class="hero-wrapper">
      <header class="hero">
        <div class="logo-text">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xml:space="preserve"
            width="42"
            height="46"
            viewBox="0 0 73.519 80.308"
          >
            <path
              d="M 35.245 80.249 c -1.65 -0.31 -3.423 -1.172 -17.991 -8.748 c -17.86 -9.289 -18.317 -9.625 -16.403 -12.059 c 0.477 -0.606 7.298 -4.423 7.905 -4.423 c 0.136 0 5.499 2.74 11.917 6.09 c 17.26 9.007 14.766 9.015 32.163 -0.107 l 11.856 -6.216 l 3.467 1.815 c 5.012 2.625 6.039 4.031 4.326 5.926 c -0.574 0.636 -30.926 16.711 -32.678 17.308 c -1.032 0.351 -3.637 0.588 -4.562 0.414"
              style="fill:#868b85;"></path>
            <path
              d="M 34.584 59.339 c -1.176 -0.259 -2.719 -1.026 -17.595 -8.756 c -17.775 -9.236 -18.27 -9.608 -16.073 -12.08 c 1.14 -1.282 7.623 -4.463 8.394 -4.117 c 0.367 0.165 5.668 2.899 11.78 6.076 c 16.826 8.747 14.402 8.77 31.657 -0.285 c 6.351 -3.333 11.681 -6.06 11.844 -6.06 c 0.572 0 7.23 3.479 7.856 4.105 c 2.458 2.457 2.012 2.8 -15.93 12.244 c -17.513 9.22 -18.516 9.625 -21.933 8.873"
              style="fill:#998468;"></path>
            <path
              d="M 33.607 38.243 c -2.178 -0.778 -31.865 -16.392 -32.56 -17.125 c -2.385 -2.518 -1.888 -2.911 14.62 -11.547 c 19.714 -10.315 17.742 -9.389 20.3 -9.53 c 3.263 -0.181 3.356 -0.141 20.099 8.565 c 22.428 11.664 22.407 9.528 0.214 21.163 c -18.23 9.557 -18.919 9.814 -22.673 8.474"
              style="fill:#63805e;"></path>
          </svg>
          <span>Bedrock.engineer</span>
        </div>

        <!-- <h1>Bridge subsurface data <br />and modern geospatial tools</h1> -->
        <h1>
          Visualize. <wbr />Integrate.<wbr /> Optimize. <br />Your Subsurface
          Data
        </h1>

        <!-- <p>
          Go from subsurface data stuck in gINT, AGS, or GEF to tools that make
          it accessible and useful. Surface your subsurface data in web maps,
          ArcGIS, QGIS, or AEC collaboration platforms.
        </p> -->

        <p class="md:text-lg">
          Surface your subsurface data in web maps, Python, QGIS, and AEC
          platforms, escape proprietary databases like gINT or industry-specific
          file formats like AGS and GEF.
        </p>

        <!-- <p>Go from subsurface data stuck in gINT, AGS, or GEF to web maps, ArcGIS, QGIS, and AEC collaboration platforms—accessible wherever you need it.</p> -->

        <!-- "Surface your subsurface data—go from gINT, AGS, and GEF files to web maps, ArcGIS, QGIS, and AEC platforms." -->

        <div class="flex gap-4 justify-center flex-wrap mt-12">
          <a
            href="https://cal.com/bedrock.engineer"
            class="cta-button-inverted"
            target="_blank"
          >
            Schedule Discovery Call
          </a>
          <a href="/demos" class="cta-button-secondary-inverted">View Demos</a>
        </div>
      </header>

      <div class="header-controls">
        <Search />
        <ThemeToggle />
      </div>

      <section class="worked-with">
        <h2
          style="color: var(--gray-10); text-align: center; margin-inline: auto;"
        >
          We have worked with
        </h2>

        <div class="client-logos pt-6">
          <!-- SVG as img doesnt do dark mode in safari -->
          <!-- <img src={fugroLogo.src} alt="Fugro" /> -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xml:space="preserve"
            width="100"
            viewBox="0 0 1244.58 568.53"
          >
            <defs>
              <style>
                path#fugro {
                  fill: #041e41;
                }

                :root:not([data-theme="light"]) #fugro {
                  fill: white;
                }
              </style>
            </defs>
            <path
              id="fugro"
              d="M622.5 630.22c-13.26 0-27.23-13.38-27.23-27.22v-99.55c0-13.86 13.97-27.22 27.23-27.22h148.7c13.26 0 27.21 13.37 27.21 27.22v22.12h-79.88s0-14.17-21.69-14.17c-21.68 0-22.12 15.93-22.12 15.93v54.87s.22 17.71 22.35 17.71 22.35-19.48 22.35-19.48V569.6h-21.46v-26.55h101.13v87.18h-73.25l-7.52-12.84s-7.99 12.84-20.37 12.84H622.5ZM833.13 630.21v-154h194.71s30.53 2.66 30.53 28.77v36.73c0 26.1-30.53 28.77-30.53 28.77h-15.5l48.69 59.74h-99.58L915.2 576.9v53.32h-82.07zm119.26-79.88s15.94-1.99 15.94-21.25c0-19.25-15.94-21.23-15.94-21.23H915.2v42.48zM1292.01 602.32c0 13.86-13.94 27.21-27.2 27.21l-6.86.67h-139.62c-13.29 0-27.23-13.37-27.23-27.22v-99.56c0-13.84 13.94-27.21 27.23-27.21h146.26c13.27 0 27.42 13.38 27.42 27.21zm-77.25-73.18s-.41-19.3-22.07-19.3c-21.7 0-22.13 20.8-22.13 20.8v51.55s.21 17.71 22.34 17.71 21.92-19.48 21.92-19.48zM246.56 387.91H435.3v47.14H309.83c-4.42 0-9.06 4.21-9.06 9.08v32.07h136.51v102.46s.89 21.46 20.36 21.46c19.48 0 20.36-21.46 20.36-21.46V476.2h79.65l-.23 126.58c0 13.85-13.95 27.43-27.22 27.43H382.86c-13.26 0-27.22-13.37-27.22-27.21v-91.6H301.2v355.79l-40.93 69.25-40.71-69.25v-355.8H67.43v-35.17h151.9v-61.08c0-13.86 12.64-27.23 25.89-27.23"
              transform="translate(-57.43 -377.91)"></path>
          </svg>
        </div>
        <!-- <img src={zeelandLogo.src} alt="Zeeland" /> -->
        <!-- <img src={tnoGdnLogo.src} alt="TNO-GDN" /> -->

        <!-- <div style="margin-top: 32px; text-align: center;">
          <a href="/cases" class="section-link">View case studies →</a>
        </div> -->
      </section>
    </div>

    <div class="section-wrapper texture-232-k">
      <section class="section tabs-section">
        <AnimatedDemoTabs client:load />

        <div style="margin-top: 40px; text-align: center;">
          <a href="/demos" class="section-link">
            Explore all interactive demos →
          </a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-607">
      <section class="section">
        <h2 class="heading-2">A Software Consultancy for Subsurface Data</h2>

        <div class="grid-auto-fit gap-y-8">
          <div>
            <p class="paragraph" style="margin-block-end: 24px">
              Ground investigation data is trapped in proprietary databases
              (gINT), text formats (AGS, GEF), and specialist software, while
              geospatial tools thrive in a separate, open and interoperable
              ecosystem.
              <!-- Custom builds require rare dual expertise. -->
            </p>

            <p class="paragraph" style="margin-block-end: 24px">
              Bedrock.engineer bridges this gap. We're a software consultancy
              specialized in subsurface data. We build tools and workflows that
              connect your ground investigation data to modern platforms like
              QGIS, web maps, PostGIS databases, and BIM tools.
            </p>

            <h3 style="font-size: 20px; margin-block: 16px; font-weight: 600;">
              What we do:
            </h3>
            <ul class="services-list paragraph">
              <li>
                Convert legacy formats (AGS, GEF/CPT, gINT) into modern
                geospatial formats like GeoPackage or geospatial databases like
                PostGIS
              </li>
              <li>
                Build web applications for CPT data management, engineering
                model visualization (Plaxis, Deltares D-Series), and interactive
                3D maps
              </li>
              <li>
                Integrate ground investigation data into digital twin platforms
                for infrastructure planning
              </li>
              <li>
                Create automated workflows connecting subsurface data to QGIS,
                BIM platforms, and design tools
              </li>
            </ul>
          </div>

          <HoverLogo class="place-self-center" />
        </div>

        <div style="margin-top: 40px; text-align: center;">
          <a href="/services" class="section-link">
            Learn about our services →
          </a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-616">
      <section class="section">
        <h2 class="heading-2">Our Values</h2>

        <div class="grid-auto-fit" style="--grid-gap: 72px;">
          <div class="value-card">
            <h3 class="value-title text-xl font-semibold">
              Purpose-built for subsurface data
            </h3>
            <p>
              We build tools specifically for subsurface data, applied to your
              specific workflows. Not generic software that "almost" fits.
              Reusable patterns for subsurface data that we adapt to your needs.
              You get tailored tools without custom-build costs.
            </p>
          </div>

          <div class="value-card">
            <h3 class="value-title text-xl font-semibold">
              Interoperable geospatial data
            </h3>
            <p>
              Modern geospatial formats mean your subsurface data works
              everywhere, QGIS, ArcGIS, Python, web maps, geospatial databases.
              We bring practices from modern software development and the
              geospatial ecosystem to subsurface data.
            </p>
          </div>

          <div class="value-card">
            <h3 class="value-title text-xl font-semibold">Open ecosystems</h3>
            <p>
              We believe deeply in open-source software and open standards to
              make subsurface data more accessible and understandable, and drive
              innovation in geotechnical engineering. We maintain
              <code
                ><a href="https://github.com/bedrock-engineer/bedrock-ge/"
                  >bedrock-ge</a
                ></code
              >, our open-source Python library for turning ground investigation
              data into geospatial data we use in projects.
            </p>
          </div>
        </div>

        <div style="margin-top: 40px; text-align: center;">
          <a href="/mission" class="section-link">
            Learn about our mission →
          </a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-668">
      <section class="section team" style="--grid-color: black;">
        <h2 class="heading-2">The Team</h2>

        <div class="team-member-grid">
          <Card class="team-member card">
            <h3>Jules Blom</h3>
            <Image src={jules} alt="Jules Blom" style="filter: grayscale(1);" />
            <p>
              Experienced in building data-rich geospatial applications.
              Specializes in making complex subsurface data clear through
              visualization and intuitive user interfaces. Background in
              Petroleum Engineering (Reservoir Geology) at TU Delft.
            </p>
          </Card>

          <Card class="team-member card">
            <h3>Joost Gevaert</h3>
            <Image
              src={joost}
              alt="Joost Gevaert"
              style="filter: grayscale(1);"
            />
            <p>
              Geotechnical engineer and computational designer. Worked at Arup
              bridging gaps between geotechnical and structural engineering
              workflows. Background in Geotechnical Engineering and Applied
              Geophysics.
            </p>
          </Card>
        </div>

        <div style="margin-top: 48px; text-align: center;">
          <a href="/about" class="section-link">More about the team →</a>
        </div>
      </section>
    </div>

    <Footer />
  </div>

  <style>
    @reference "../styles/custom.css";

    .paragraph {
      font-size: 18px;
      max-width: 50ch;
    }

    /* Alternate background colors for sections */
    .section-wrapper:nth-child(even) .section {
      background: var(--brown-1);
    }

    .section-wrapper:nth-child(odd) .section {
      background: var(--gray-1);
    }

    .hero-wrapper {
      padding-inline: 16px;
      border-bottom: 1px solid var(--border-color);
      @media (max-width: 640px) {
        padding-inline: 8px;
      }
    }

    .hero {
      margin-top: 12px;
      min-height: 620px;
      max-width: var(--container-wide);
      padding-block: 16px;
      margin-inline: auto;
      border-radius: 16px;
      text-align: center;
      color: white;
      background:
        linear-gradient(
          to bottom,
          oklch(10% 0.04244 152.546 / 0.6) 20%,
          oklch(14% 0.0086 134.306 / 0.95) 100%
        ),
        url("/ASCII-landscape.webp");
      background-size: cover;

      background-position: center;
      position: relative;
      display: grid;
      place-content: center;

      & > * {
        margin-inline: auto;
      }

      & h1 {
        font-size: clamp(1.8rem, 1.75rem + 2.4vw, 4rem);
        margin-top: 32px;
        margin-bottom: 16px;
        font-family: "IBM Plex Sans Condensed";
        text-box-trim: trim-both;
        text-wrap: balance;
      }

      & p {
        max-width: 50ch;
        text-align: center;
      }
    }

    .worked-with {
      border-top: none;
      padding-block-start: 32px;
      padding-block-end: 48px;

      & h2 {
        /* text-align: center; */
        font-size: 20px;
        margin-left: 108px;
        margin-bottom: 36px;
      }
    }

    .header-controls {
      position: fixed;
      top: 16px;
      right: 24px;
      display: flex;
      flex-direction: row;
      align-items: end;
      gap: 4px;

      @media (max-width: 768px) {
        right: 12px;
        flex-direction: column-reverse;
      }
    }

    .logo-text {
      display: flex;
      align-items: center;
      justify-content: center;
      column-gap: 9px;
      font-size: 36px;
      font-family: "IBM Plex Sans Condensed";
      position: absolute;
      top: 16px;
      left: 20px;

      @media (max-width: 640px) {
        font-size: 24px;
        column-gap: 6px;
        left: 12px;

        & svg {
          width: 28px;
          height: 31px;
        }
      }
    }

    .client-logos {
      display: flex;
      column-gap: 64px;
      row-gap: 48px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;

      img {
        height: 48px;
        object-fit: contain;
      }
    }

    .team-member-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
      gap: 16px;
      container-type: inline-size;
      container-name: team-grid;
    }

    .team-member {
      display: grid;
      grid-template-areas:
        "image description"
        "name description";
      column-gap: 24px;
      row-gap: 12px;
      padding-block: 20px;
      padding-inline: 32px;

      & img {
        grid-area: image;
        min-width: 100px;
        max-width: min(220px, 100%);
        border-radius: 100%;
      }

      & h3 {
        grid-area: name;
        font-size: 1.25em;
        text-align: center;
      }

      & p {
        min-width: 20ch;
        grid-area: description;
      }
    }

    @container team-grid (width < 80ch) {
      .team-member {
        grid-template-areas:
          "image"
          "name"
          "description";
        justify-items: center;
      }
    }

    .tabs-section {
      padding-block-start: 0;
    }

    .services-list {
      list-style: none;
      padding-left: 0;

      li {
        padding-left: 24px;
        margin-block: 12px;
        position: relative;

        &::before {
          content: "→";
          position: absolute;
          left: 0;
          color: var(--green-8);
          font-weight: bold;
        }
      }
    }

    /* .values-grid replaced with .grid-auto-fit-narrow from global CSS */

    .value-card {
      @apply flex flex-col gap-x-8 gap-y-4;
      & p {
        flex-grow: 1;
        line-height: 1.6;
        max-width: 40ch;
      }

      & code {
        background: var(--gray-3);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
      }
    }

    .value-title {
      font-family: "IBM Plex Sans Condensed";
      color: var(--gray-12);
    }

    .value-link {
      @apply no-underline inline-flex items-center gap-1;
      color: var(--green-11);
      transition: gap 0.2s;
      font-weight: 500;

      &:hover {
        gap: 8px;
        text-decoration: underline;
      }
    }
  </style>

  <style is:global>
    /* Override Search button to stay icon-only (not expand to a search bar) */
    .header-controls button[data-open-modal] {
      background: var(--gray-6) !important;
      border: 1px solid var(--gray-4) !important;
      border-radius: var(--border-radius-sm) !important;
      color: var(--gray-12) !important;
      width: 36px !important;
      max-width: none !important;
      height: 36px !important;
      padding: 0 !important;
      justify-content: center !important;
    }
    .header-controls button[data-open-modal]:hover {
      background: var(--gray-7) !important;
    }
    /* Hide the text label and keyboard shortcut */
    .header-controls button[data-open-modal] span,
    .header-controls button[data-open-modal] kbd {
      display: none !important;
    }
    /* Remove the ThemeToggle's built-in top margin so it aligns in the flex row */
    .header-controls #triangle-toggle {
      margin-top: 0;
    }
    /* Center the search dialog on the landing page (Starlight defaults to top-aligned) */
    .header-controls dialog {
      margin: auto;
    }
  </style>
</BaseLayout>
