---
import Image from "astro/components/Image.astro";
import Search from "@astrojs/starlight/components/Search.astro";

import joost from "../assets/JoostGevaert.jpg";
import jules from "../assets/JulesBlom.jpg";
import bInventedLogo from "../assets/logos/b-invented.png";;
import cruxLogo from "../assets/logos/crux.png";
import geotopSouthHolland from "../assets/geotop-south-holland.png";

import { AnimatedDemoTabs } from "../components/AnimatedDemoTabs";
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import HoverLogo from "../components/HoverLogo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/custom.css";
