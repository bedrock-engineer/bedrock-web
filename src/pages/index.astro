  <style>
    @reference "../styles/custom.css";

    .paragraph {
      max-width: 50ch;
    }

    .section-link-center {
      margin-block-start: var(--space-l);
      text-align: center;
    }

    /* Alternate background colors for sections */
    .section-wrapper:nth-child(even) .section {
      background: var(--brown-1);
    }

    .section-wrapper:nth-child(odd) .section {
      background: var(--gray-1);
    }

    .hero-wrapper {
      padding-inline: var(--space-s);
      border-bottom: 1px solid var(--border-color);
      @media (max-width: 640px) {
        padding-inline: var(--space-2xs);
      }
    }

    .hero {
      margin-top: 12px;
      min-height: 620px;
      max-width: var(--container-wide);
      padding-block: 16px;
      margin-inline: auto;
      border-radius: 16px;
      text-align: center;
      color: white;
      background:
        linear-gradient(
          to bottom,
          oklch(10% 0.04244 152.546 / 0.6) 20%,
          oklch(14% 0.0086 134.306 / 0.95) 100%
        ),
        url("/ASCII-landscape.webp");
      background-size: cover;

      background-position: center;
      position: relative;
      display: grid;
      place-content: center;

      & > * {
        margin-inline: auto;
      }

      & h1 {
        font-size: clamp(1.8rem, 1.75rem + 2.4vw, 4rem);
        margin-top: var(--space-l);
        margin-bottom: var(--space-s);
        font-family: var(--font-condensed);
        text-box-trim: trim-both;
        text-wrap: balance;
      }

      & p {
        max-width: 50ch;
        text-align: center;
      }
    }

    .worked-with {
      border-top: none;
      padding-block-start: var(--space-l);
      padding-block-end: var(--space-xl);

      & h2 {
        font-size: var(--text-xl);
        color: var(--gray-10);
        text-align: center;
        margin-inline: auto;
        margin-bottom: var(--space-m-l);
      }
    }

    .header-controls {
      position: fixed;
      top: 16px;
      right: 24px;
      display: flex;
      flex-direction: row;
      align-items: end;
      gap: 4px;

      @media (max-width: 768px) {
        right: 12px;
        flex-direction: column-reverse;
      }
    }

    .logo-text {
      display: flex;
      align-items: center;
      justify-content: center;
      column-gap: 9px;
      font-size: 36px;
      font-family: var(--font-condensed);
      position: absolute;
      top: var(--space-s);
      left: 20px;

      @media (max-width: 640px) {
        font-size: 24px;
        column-gap: 6px;
        left: var(--space-xs);

        & svg {
          width: 28px;
          height: 31px;
        }
      }
    }

    .client-logos {
      display: flex;
      column-gap: var(--space-2xl);
      row-gap: var(--space-xl);
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;

      img {
        height: 48px;
        object-fit: contain;
      }
    }

    .team-member-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
      gap: var(--space-s);
      container-type: inline-size;
      container-name: team-grid;
    }

    .team-member {
      display: grid;
      grid-template-areas:
        "image description"
        "name description";
      column-gap: var(--space-m);
      row-gap: var(--space-xs);
      padding-block: var(--space-s);
      padding-inline: var(--space-l);

      & img {
        grid-area: image;
        min-width: 100px;
        max-width: min(220px, 100%);
        border-radius: 100%;
      }

      & h3 {
        grid-area: name;
        font-size: 1.25em;
        text-align: center;
      }

      & p {
        min-width: 20ch;
        grid-area: description;
      }
    }

    @container team-grid (width < 80ch) {
      .team-member {
        grid-template-areas:
          "image"
          "name"
          "description";
        justify-items: center;
      }
    }

    .tabs-section {
      padding-block-start: 0;
    }

    .voxel-callout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-l);
      align-items: center;
      text-decoration: none;
      color: inherit;
      border-radius: var(--border-radius);
      transition: background 0.15s;

      &:hover {
        background: var(--gray-2);
      }

      &:hover .section-link {
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
      }
    }

    .voxel-callout-image {
      border-radius: var(--border-radius-sm);
      width: 80%;
      height: auto;
    }

    .voxel-callout-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);

      & p {
        line-height: 1.6;
        max-width: 40ch;
      }
    }

    .cesium-badge {
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.2em 0.6em;
      background: var(--green-3);
      color: var(--green-11);
      border-radius: var(--border-radius-sm);
      width: fit-content;
    }

    .services-list {
      list-style: none;
      padding-left: 0;

      li {
        padding-left: var(--space-m);
        margin-block: var(--space-xs);
        position: relative;

        &::before {
          content: "→";
          position: absolute;
          left: 0;
          color: var(--green-8);
          font-weight: bold;
        }
      }
    }

    /* .values-grid replaced with .grid-auto-fit-narrow from global CSS */

    .value-card {
      @apply flex flex-col gap-x-8 gap-y-4;
      & p {
        flex-grow: 1;
        line-height: 1.6;
        max-width: 40ch;
      }

      & code {
        background: var(--gray-3);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
      }
    }

    .value-title {
      font-family: var(--font-condensed);
      color: var(--gray-12);
    }
  </style>

  <style is:global>
    /* Override Search button to stay icon-only (not expand to a search bar) */
    .header-controls button[data-open-modal] {
      background: var(--gray-6) !important;
      border: 1px solid var(--gray-4) !important;
      border-radius: var(--border-radius-sm) !important;
      color: var(--gray-12) !important;
      width: 36px !important;
      max-width: none !important;
      height: 36px !important;
      padding: 0 !important;
      justify-content: center !important;
    }
    .header-controls button[data-open-modal]:hover {
      background: var(--gray-7) !important;
    }
    /* Hide the text label and keyboard shortcut */
    .header-controls button[data-open-modal] span,
    .header-controls button[data-open-modal] kbd {
      display: none !important;
    }
    /* Remove the ThemeToggle's built-in top margin so it aligns in the flex row */
    .header-controls #triangle-toggle {
      margin-top: 0;
    }
    /* Center the search dialog on the landing page (Starlight defaults to top-aligned) */
    .header-controls dialog {
      margin: auto;
    }

    :root:not([data-theme="dark"]) {
      #b-invented-logo {
        filter: invert(1) grayscale(1);
      }
    }
  </style>
</BaseLayout>
