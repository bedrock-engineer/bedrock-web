---
import fugroLogo from "../assets/logos/fugro.svg";
import zeelandLogo from "../assets/logos/zeeland.svg";
import tnoGdnLogo from "../assets/logos/tno-gdn.svg";
import joost from "../assets/JoostGevaert.jpg";
import jules from "../assets/JulesBlom.jpg";

import { AnimatedDemoTabs } from "../components/AnimatedDemoTabs";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import "../styles/custom.css";
import Card from "../components/Card.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<BaseLayout>
  <div class="page">
    <div class="hero-wrapper">
      <header class="hero">
        <div class="logo-text">
          <!-- <svg
            xmlns="http://www.w3.org/2000/svg"
            xml:space="preserve"
            width="100"
            height="100"
            viewBox="0 0 100 100"
          >
          <rect fill="#868b85" stroke="white" stroke-width="10" paint-order="stroke" transform="rotate(45) skewX(-25)   skewY(5) translate(50, 40)" rx="8" transform-box="fill-box" transform-origin="center" rx="4" width="50" height="50"></rect>
          <rect fill="#998468" stroke="white" stroke-width="10" paint-order="stroke" transform="rotate(45) skewX(-25)   skewY(5) translate(30, 25)" rx="8" transform-box="fill-box" transform-origin="center" rx="4" width="50" height="50"></rect>
            <rect fill="#63805e" stroke="white" stroke-width="10" paint-order="stroke" transform="rotate(45) skewX(-25) skewY(5)  translate(10, 10)" rx="8" transform-box="fill-box" transform-origin="center" rx="4" width="50" height="50"></rect>
          </svg> -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xml:space="preserve"
            width="42"
            height="46"
            viewBox="0 0 73.519 80.308"
          >
            <path
              d="M 35.245 80.249 c -1.65 -0.31 -3.423 -1.172 -17.991 -8.748 c -17.86 -9.289 -18.317 -9.625 -16.403 -12.059 c 0.477 -0.606 7.298 -4.423 7.905 -4.423 c 0.136 0 5.499 2.74 11.917 6.09 c 17.26 9.007 14.766 9.015 32.163 -0.107 l 11.856 -6.216 l 3.467 1.815 c 5.012 2.625 6.039 4.031 4.326 5.926 c -0.574 0.636 -30.926 16.711 -32.678 17.308 c -1.032 0.351 -3.637 0.588 -4.562 0.414"
              style="fill:#868b85;"></path>
            <path
              d="M 34.584 59.339 c -1.176 -0.259 -2.719 -1.026 -17.595 -8.756 c -17.775 -9.236 -18.27 -9.608 -16.073 -12.08 c 1.14 -1.282 7.623 -4.463 8.394 -4.117 c 0.367 0.165 5.668 2.899 11.78 6.076 c 16.826 8.747 14.402 8.77 31.657 -0.285 c 6.351 -3.333 11.681 -6.06 11.844 -6.06 c 0.572 0 7.23 3.479 7.856 4.105 c 2.458 2.457 2.012 2.8 -15.93 12.244 c -17.513 9.22 -18.516 9.625 -21.933 8.873"
              style="fill:#998468;"></path>
            <path
              d="M 33.607 38.243 c -2.178 -0.778 -31.865 -16.392 -32.56 -17.125 c -2.385 -2.518 -1.888 -2.911 14.62 -11.547 c 19.714 -10.315 17.742 -9.389 20.3 -9.53 c 3.263 -0.181 3.356 -0.141 20.099 8.565 c 22.428 11.664 22.407 9.528 0.214 21.163 c -18.23 9.557 -18.919 9.814 -22.673 8.474"
              style="fill:#63805e;"></path>
          </svg>
          <span>Bedrock.engineer</span>
        </div>

        <h1>
          View ground conditions with<br /> building models and site plans
        </h1>

        <p>
          Go from subsurface data that is stuck in gINT, AGS, or GEF or
          engineering suites to focused software that makes it accessible and
          useful. Bedrock.engineer transforms subsurface data into web maps and
          formats that work with ArcGIS, QGIS, AEC collaboration platforms like
          Speckle.
        </p>

        <div class="flex gap-4 justify-center flex-wrap">
          <a
            href="https://cal.com/bedrock-engineer"
            class="cta-button-inverted"
          >
            Schedule Discovery Call
          </a>
          <a href="/demos" class="cta-button-secondary-inverted">View Demos</a>
        </div>
      </header>
      <ThemeToggle class="fixed top-3 right-4" />

      <section class="worked-with">
        <h2>We have worked with</h2>

        <div class="client-logos">
          <img src={fugroLogo.src} alt="Fugro" />
          <img src={zeelandLogo.src} alt="Zeeland" />
          <img src={tnoGdnLogo.src} alt="TNO-GDN" />
        </div>

        <div style="margin-top: 32px; text-align: center;">
          <a href="/cases" class="section-link">View case studies →</a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-232-k">
      <section class="section tabs-section">
        <AnimatedDemoTabs client:load />

        <div style="margin-top: 40px; text-align: center;">
          <a href="/demos" class="section-link">
            Explore all interactive demos →
          </a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-607">
      <section class="section">
        <h2 class="heading-3">A Software Consultancy for Subsurface Data</h2>

        <div class="flex gap-10">
          <div>
            <p class="paragraph" style="margin-block-end: 24px">
              Subsurface data is trapped in proprietary databases, or text
              formats like AGS or GEF, or in specialist software while
              geospatial tools thrive in a separate, open ecosystem.
              <!-- Custom builds require rare dual expertise. -->
            </p>

            <p class="paragraph" style="margin-block-end: 24px">
              Bedrock.engineer develops tools that understand subsurface data
              natively, tailored to how you actually work.
            </p>

            <h3 style="font-size: 20px; margin-block: 16px; font-weight: 600;">
              What we do:
            </h3>
            <ul class="services-list paragraph">
              <li>Convert legacy formats into modern geospatial standards</li>
              <li>
                Build interactive (3D) web maps and visualizations for
                stakeholder engagement
              </li>
              <li>
                Create automated workflows connecting subsurface data to GIS and
                BIM tools
              </li>
              <li>Develop custom integrations for your specific needs</li>
            </ul>
          </div>
        </div>

        <div style="margin-top: 40px; text-align: center;">
          <a href="/services" class="section-link">
            Learn about our services →
          </a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-616">
      <section class="section">
        <h2 class="heading-3">Our Values</h2>

        <div class="grid-auto-fit-narrow">
          <div class="value-card">
            <h3 class="value-title text-xl font-semibold">
              Open-source & open standards
            </h3>
            <p>
              We believe deeply in open-source software and open standards to to
              make subsurface data more accessible and understandable, and drive
              innovation in geotechnical engineering. We develop <code
                >bedrock-ge</code
              >, our own open-source Python library for turning ground
              investigation data into geospatial data.
            </p>
          </div>

          <div class="value-card">
            <h3 class="value-title text-xl font-semibold">
              Modern geospatial standards
            </h3>
            <p>
              Your ground investigation data converts to GeoPackage, GeoParquet,
              GeoJSON; formats that work with every modern GIS tool, Python
              workflow, and web mapping platform. Long-term accessibility and
              compatibility guaranteed.
            </p>
          </div>

          <div class="value-card">
            <h3 class="value-title text-xl font-semibold">Purpose built</h3>
            <p>
              Tailored tools built specifically for subsurface data, applied to
              your specific workflows. Not generic software that "almost" fits.
              Not expensive custom builds. Proven patterns for subsurface data,
              repeatable but flexible, with iteration as part of the process.
            </p>
            <!-- <a href="/automation" class="value-link">Learn about our approach →</a> -->
          </div>
        </div>

        <div style="margin-top: 40px; text-align: center;">
          <a href="/mission" class="section-link">
            Learn about our mission →
          </a>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-668">
      <section class="section team" style="--grid-color: black;">
        <h2 class="heading-3">The Team</h2>

        <div class="grid-auto-fit">
          <Card class="team-member card">
            <h3>Jules Blom</h3>
            <img src={jules.src} alt="Jules Blom" />
            <p>
              5+ years building data-rich geospatial applications. Specializes
              in making complex subsurface data clear through visualization and
              user intuitive interfaces. Background in Reservoir Geology (TU
              Delft).
            </p>
          </Card>

          <Card class="team-member card">
            <h3>Joost Gevaert</h3>
            <img src={joost.src} alt="Joost Gevaert" />
            <p>
              Geotechnical engineer and computational designer. Spent 4 years at
              Arup bridging gaps between geotechnical and structural engineering
              workflows. Background in Geotechnical Engineering and Applied
              Geophysics.
            </p>
          </Card>
        </div>

        <div style="margin-top: 48px; text-align: center;">
          <a href="/about" class="section-link">More about the team →</a>
        </div>
      </section>
    </div>
    <Footer />
  </div>

  <style>
    @reference "../styles/custom.css";

    .paragraph {
      font-size: 18px;
      max-width: 50ch;
    }

    /* Alternate background colors for sections */
    .section-wrapper:nth-child(even) .section {
      background: var(--brown-1);
    }

    .section-wrapper:nth-child(odd) .section {
      background: var(--gray-1);
    }

    .hero-wrapper {
      padding-inline: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .hero {
      margin-top: 12px;
      min-height: 620px;
      max-width: var(--container-wide);
      padding-block: 16px;
      margin-inline: auto;
      border-radius: 16px;
      text-align: center;
      display: flex;
      flex-direction: column;
      row-gap: 32px;
      justify-content: center;
      color: white;
      background:
        linear-gradient(
          to bottom,
          oklch(10% 0.04244 152.546 / 0.6) 20%,
          oklch(14% 0.0086 134.306 / 0.95) 100%
        ),
        url("/ASCII-landscape.webp");
      background-size: cover;
      background-position: center;
      position: relative;

      & > * {
        margin-inline: auto;
      }

      & h1 {
        font-size: clamp(2.8rem, 2.25rem + 2vw, 4rem);
        margin-top: 5%;
        font-family: "IBM Plex Sans Condensed";
        text-box-trim: trim-both;
        text-wrap: balance;
      }

      & p {
        font-size: 1.2em;
        max-width: 50ch;
        text-align: center;
      }
    }

    .worked-with {
      border-bottom: 1px solid var(--border-color-light);
      border-top: none;
      padding-block-start: 32px;
      padding-block-end: 48px;

      & h2 {
        text-align: center;
        font-size: 20px;
        margin-bottom: 36px;
      }
    }

    .logo-text {
      display: flex;
      align-items: center;
      justify-content: center;
      column-gap: 9px;
      font-size: 36px;
      font-family: "IBM Plex Sans Condensed";
      position: absolute;
      top: 16px;
      left: 20px;
    }

    .client-logos {
      display: flex;
      column-gap: 64px;
      row-gap: 48px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;

      img {
        height: 48px;
        object-fit: contain;
      }
    }

    .team-member {
      display: grid;
      max-width: 520px;
      grid-template-areas:
        "image description"
        "name description";
      column-gap: 24px;
      row-gap: 12px;
      padding-block: 20px;
      padding-inline: 32px;

      & img {
        grid-area: image;
        border-radius: 100%;
      }

      & h3 {
        grid-area: name;
        font-size: 1.25em;
        text-align: center;
      }

      & p {
        grid-area: description;
      }
    }

    .tabs-section {
      padding-block-start: 0;
    }

    .services-list {
      list-style: none;
      padding-left: 0;

      li {
        padding-left: 24px;
        margin-block: 12px;
        position: relative;

        &::before {
          content: "→";
          position: absolute;
          left: 0;
          color: var(--green-8);
          font-weight: bold;
        }
      }
    }

    /* .values-grid replaced with .grid-auto-fit-narrow from global CSS */

    .value-card {
      /* @apply p-6 bg-[var(--gray-2)] border border-[var(--border-color-light)] rounded-sm flex flex-col gap-4; */
      @apply p-6 flex flex-col gap-4;
      & p {
        flex-grow: 1;
        line-height: 1.6;
        max-width: 40ch;
      }

      & code {
        background: var(--gray-3);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
      }
    }

    .value-title {
      font-family: "IBM Plex Sans Condensed";
      color: var(--gray-12);
    }

    .value-link {
      @apply no-underline inline-flex items-center gap-1;
      color: var(--green-11);
      transition: gap 0.2s;
      font-weight: 500;

      &:hover {
        gap: 8px;
        text-decoration: underline;
      }
    }

    /* .section-link now in global custom.css */

    /* Button styles now in global custom.css */
  </style>
</BaseLayout>
