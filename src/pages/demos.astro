---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoCard from "../components/DemoCard.astro";
import Link from "../components/Link.astro";
import { demos, demosById, availableTags, tagDimensions } from "../data/demos";
import "../styles/custom.css";

const title =
  "Interactive Subsurface & BIM Demos - CesiumJS, GEF Viewer, IFC Georeferencer, Speckle | Bedrock.engineer";
const description =
  "Explore examples of subsurface and BIM data in interactive visualizations and browser tools. See AGS4, GEF, BRO/XML, and IFC data in web application, CesiumJS 3D maps, or Speckle.";

const pageUrl = new URL("/demos", Astro.site);
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />

    <meta property="og:site_name" content="Bedrock.engineer" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="author" content="Bedrock.engineer" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  </Fragment>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Interactive Ground Investigation Demos",
      description:
        "Real-world examples of ground investigation data transformed into interactive visualizations",
      url: pageUrl,
      mainEntity: {
        "@type": "ItemList",
        name: "Ground Investigation Visualization Demos",
        itemListElement: demos.map((demo, i) => ({
          "@type": "SoftwareApplication",
          position: i + 1,
          name: demo.title,
          description: demo.description,
          applicationCategory: "WebApplication",
          ...(demo.href ? { url: demo.href } : {}),
        })),
      },
    })}
  />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: Astro.site,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Demos",
          item: pageUrl,
        },
      ],
    })}
  />

  <Navbar />
  <div class="page" data-pagefind-body data-pagefind-meta="category:Marketing">
    <header class="section-wrapper texture-607">
      <section class="section intro-section">
        <h1 class="heading-1">Interactive Demos</h1>
        <p class="subtitle">Subsurface and BIM Data Visualizations</p>
        <p class="paragraph-xl">
          Explore real-world examples of subsurface and BIM data across
          different platforms and tools. See ground investigation data in
          CesiumJS 3D maps and Speckle, and bridge Geo and BIM with browser
          tools like the IFC Georeferencer.
        </p>
      </section>
    </header>

    <div class="section-wrapper texture-616">
      <section class="section">
        <div class="filter-bar" role="group" aria-label="Filter demos">
          {
            tagDimensions.map((dim) => (
              <div class="filter-row">
                <span class="filter-label">{dim.label}</span>
                <div class="filter-chips">
                  {availableTags[dim.key].map((value) => (
                    <button
                      type="button"
                      class="filter-chip"
                      data-dim={dim.key}
                      data-value={value}
                      aria-pressed="false"
                    >
                      {value}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
          <button type="button" class="reset-filters" hidden>
            Reset filters
          </button>
        </div>

        <div class="grid-auto-fit demos-grid">
          <DemoCard {...demosById["kai-tak-cesium"]}>
            <Fragment slot="description">
              Ground investigation data from Kai Tak, Hong Kong visualized in an
              interactive CesiumJS map. Explore borehole locations, SPT results,
              and weathering grades in 3D context directly in your browser.
              Source data transformed from AGS3 format to GeoJSON using <code
                >bedrock-ge</code
              > for web visualization.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["bro-xml-viewer"]}>
            <Fragment slot="description">
              Free web-based viewer for BRO/XML (Basisregistratie Ondergrond)
              files. Upload and visualize CPT, geotechnical borehole and lab
              analysis, and geological borehole data directly in your browser.
              Read more about <a class="link" href="/nl/bro-xml"
                >what we build with BRO/XML</a
              > (in Dutch).
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["gef-viewer"]}>
            <Fragment slot="description">
              Free web-based viewer for GEF (Geotechnical Exchange Format)
              files. Upload and visualize CPT & bore data directly in your
              browser.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["ifc-georeferencer"]}>
            <Fragment slot="description">
              Georeference an IFC file entirely in your browser. Place the model
              on a map or enter survey points, solve a Helmert transformation,
              and download an IFC with correct <code>IfcMapConversion</code> and <code
                >IfcProjectedCRS</code
              > entities. Built for the <Link
                href="https://www.buildingsmart.nl/projecten/georefereren-ifc"
                >buildingSMART NL georeferencing guideline</Link
              >. <Link href="https://github.com/bedrock-engineer/ifc-georeferencer"
                >Source on GitHub</Link
              >.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["amsterdam-noord-cesium"]}>
            <Fragment slot="description">
              Interactive 3D web map showing interpreted Cone Penetration Test
              data along with Dutch public datasets of 3D Buildings (3DBag), and
              a 3D geological model (GeoTOP) in Amsterdam Noord using CesiumJS.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["geotop-voxels-cesium"]}>
            <Fragment slot="description">
              The Dutch GeoTOP shallow subsurface model visualized in 3D for the
              first time in a browser. Explore 100×100×0.5 meter voxels
              containing lithoclass information across Amsterdam, Delft, and
              Utrecht using CesiumJS with the 3D Tiles Voxel extension.
              <a href="/voxels" class="link">More about our voxel work →</a>
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["antwerp-cesium"]}>
            <Fragment slot="description">
              The Flemish DOV shallow subsurface model of the Antwerp urban
              region and harbor visualized as 3D Tiles Voxels in CesiumJS.
              Explore 25×25×0.5 metre voxels — over 21 million in total —
              containing proportional lithological composition (peat, clay,
              silt, sand, gravel) from ground level to 50 metres depth.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["bro-cpt-maplibre"]}>
            <Fragment slot="description">
              All 237,297 Cone Penetration Tests from the Dutch subsurface
              registry rendered instantly in your browser using MapLibre-gl.
              Zoom, filter, and remap colors without any lag. No tile server
              required, just one 35 MB PMTiles file served as a static asset.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["emerald-fre16-cesium"]}>
            <Fragment slot="description">
              Sensitive clay probability and resistivity along a survey line in
              Norway, visualized as a 3D overlay on terrain in CesiumJS. Toggle
              between sensitive clay probability and log-scale resistivity. Data
              courtesy of <a
                href="https://www.emerald-geomodelling.com/"
                class="link">Emerald Geomodelling</a>.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["kai-tak-speckle"]}>
            <Fragment slot="description">
              Building models from Revit and Civil3D combined with geotechnical
              data. View subsurface conditions alongside structural designs in
              Speckle.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["amsterdam-noord-speckle"]}>
            <Fragment slot="description">
              Subsurface data from Amsterdam Noord visualized in Speckle for
              multi-disciplinary collaboration and BIM integration.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["weka-hills-speckle"]}>
            <Fragment slot="description">
              Geological data visualization in Speckle showing subsurface
              conditions for infrastructure planning and design coordination.
            </Fragment>
          </DemoCard>

          <DemoCard {...demosById["rotterdam-speckle"]}>
            <Fragment slot="description">
              Prominent Rotterdam buildings (Zalmhaven, Maastoren, and
              Blaak/Markthal) shown in Speckle together with their foundations
              and the GeoTOP voxel model. GeoTOP represents the first 50 metres
              of the Dutch subsurface as 100×100×0.5 m voxels containing
              lithoclass and lithology information.
            </Fragment>
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <Link
                href="https://app.speckle.systems/projects/adc3bec4c0/models/$zalmhaven"
                variant="arrow">De Zalmhaven</Link
              >
              <Link
                href="https://app.speckle.systems/projects/adc3bec4c0/models/$maastoren"
                variant="arrow">Maastoren</Link
              >
              <Link
                href="https://app.speckle.systems/projects/adc3bec4c0/models/$blaak-markthal"
                variant="arrow">Blaak / Markthal</Link
              >
            </div>
          </DemoCard>
        </div>

        <div class="demos-empty" hidden>
          <h3 class="heading-3">No demos match these filters yet.</h3>
          <p class="paragraph">
            Looking for something specific? <Link
              href="https://cal.com/bedrock.engineer"
              >Schedule a Discovery Call</Link
            > or <Link href="mailto:info@bedrock.engineer">email us</Link>.
          </p>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-616">
      <section class="section cta-section">
        <h2
          class="heading-2"
          style="text-align: center; margin-block-end: 16px;"
        >
          Want to see your ground investigation data visualized?
        </h2>
        <p
          class="paragraph"
          style="text-align: center; margin-block-end: 32px; color: var(--gray-11);"
        >
          We build custom visualizations and web applications for subsurface
          data.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a
            href="https://cal.com/bedrock.engineer"
            class="cta-button"
            target="_blank"
          >
            Schedule Discovery Call
          </a>
          <a href="/services" class="cta-button-secondary">
            View Our Services
          </a>
        </div>
      </section>
    </div>
  </div>

  <Footer />

  <script>
    const dims = ["country", "type", "sourceData", "gm"] as const;
    type Dim = (typeof dims)[number];

    const filters: Record<Dim, Set<string>> = {
      country: new Set(),
      type: new Set(),
      sourceData: new Set(),
      gm: new Set(),
    };

    function readFromUrl() {
      const params = new URLSearchParams(window.location.search);
      for (const dim of dims) {
        filters[dim] = new Set(params.getAll(dim));
      }
    }

    function writeToUrl() {
      const p = new URLSearchParams();
      for (const dim of dims) {
        for (const v of filters[dim]) p.append(dim, v);
      }
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : window.location.pathname);
    }

    function cardMatches(card: HTMLElement) {
      for (const dim of dims) {
        const active = filters[dim];
        if (active.size === 0) continue;
        const raw = card.dataset[dim] || "";
        const cardTags = raw.split(",").filter(Boolean);
        const matched = [...active].some((v) => cardTags.includes(v));
        if (!matched) return false;
      }
      return true;
    }

    function applyFilters() {
      const cards = document.querySelectorAll<HTMLElement>(
        ".demo-card[data-demo-id]",
      );
      const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
      const resetBtn =
        document.querySelector<HTMLButtonElement>(".reset-filters");
      const grid = document.querySelector<HTMLElement>(".demos-grid");
      const empty = document.querySelector<HTMLElement>(".demos-empty");

      const update = () => {
        let visible = 0;
        cards.forEach((card) => {
          const m = cardMatches(card);
          card.style.display = m ? "" : "none";
          if (m) visible++;
        });
        chips.forEach((chip) => {
          const dim = chip.dataset.dim as Dim;
          const value = chip.dataset.value || "";
          const active = filters[dim].has(value);
          chip.classList.toggle("active", active);
          chip.setAttribute("aria-pressed", String(active));
        });
        const anyActive = dims.some((d) => filters[d].size > 0);
        if (resetBtn) resetBtn.hidden = !anyActive;
        if (empty) empty.hidden = visible > 0;
        if (grid) grid.hidden = visible === 0;
      };

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (
        "startViewTransition" in document &&
        typeof document.startViewTransition === "function" &&
        !reduced
      ) {
        document.startViewTransition(update);
      } else {
        update();
      }
    }

    function init() {
      readFromUrl();

      document
        .querySelectorAll<HTMLButtonElement>(".filter-chip")
        .forEach((chip) => {
          chip.addEventListener("click", () => {
            const dim = chip.dataset.dim as Dim;
            const value = chip.dataset.value || "";
            if (filters[dim].has(value)) filters[dim].delete(value);
            else filters[dim].add(value);
            writeToUrl();
            applyFilters();
          });
        });

      document
        .querySelector<HTMLButtonElement>(".reset-filters")
        ?.addEventListener("click", () => {
          for (const dim of dims) filters[dim].clear();
          writeToUrl();
          applyFilters();
        });

      applyFilters();
    }

    init();
  </script>
</BaseLayout>

<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-end: var(--space-m);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: var(--font-condensed);
    font-weight: var(--font-semibold);
    color: var(--gray-11);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex: 0 0 auto;
    min-width: 5.5rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .filter-chip {
    appearance: none;
    background: transparent;
    color: var(--gray-12);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 2px 10px;
    font-size: var(--text-xs);
    font-family: inherit;
    line-height: 1.5;
    cursor: pointer;

    @media (prefers-reduced-motion: no-preference) {
      transition:
        background 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    }
  }

  .filter-chip:hover {
    border-color: var(--green-7);
  }

  .filter-chip:focus-visible {
    outline: 2px solid var(--green-9);
    outline-offset: 2px;
  }

  .filter-chip.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .reset-filters {
    align-self: flex-start;
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin-block-start: var(--space-3xs);
    color: var(--green-9);
    cursor: pointer;
    font-weight: var(--font-semibold);
    font-size: var(--text-xs);
    text-decoration: underline;
    font-family: inherit;
  }

  .reset-filters:hover {
    color: var(--green-10);
  }

  .reset-filters:focus-visible {
    outline: 2px solid var(--green-9);
    outline-offset: 2px;
  }

  .demos-empty {
    text-align: center;
    padding: var(--space-2xl) var(--space-m);
  }

  .demos-empty .heading-3 {
    margin-block-end: var(--space-s);
  }
</style>

