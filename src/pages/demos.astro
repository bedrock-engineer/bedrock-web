---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoCard from "../components/DemoCard.astro";
import Link from "../components/Link.astro";
import { demoItems, availableTags, tagDimensions } from "../data/demos";
import "../styles/custom.css";

const title =
  "Interactive Subsurface & BIM Demos - CesiumJS, MapLibre, Speckle | Bedrock.engineer";
const description =
  "Explore examples of subsurface and BIM data in interactive visualizations. See AGS, BRO/XML, NetCDF, and CSV data in CesiumJS 3D maps, MapLibre, and Speckle.";

const pageUrl = new URL("/demos", Astro.site);
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />

    <meta property="og:site_name" content="Bedrock.engineer" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="author" content="Bedrock.engineer" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  </Fragment>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Interactive Ground Investigation Demos",
      description:
        "Real-world examples of ground investigation data transformed into interactive visualizations",
      url: pageUrl,
      mainEntity: {
        "@type": "ItemList",
        name: "Ground Investigation Visualization Demos",
        itemListElement: demoItems.map((demo, i) => ({
          "@type": "SoftwareApplication",
          position: i + 1,
          name: demo.title,
          description: demo.description,
          applicationCategory: "WebApplication",
          ...(demo.href ? { url: demo.href } : {}),
        })),
      },
    })}
  />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: Astro.site,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Demos",
          item: pageUrl,
        },
      ],
    })}
  />

  <Navbar />
  <div class="page" data-pagefind-body data-pagefind-meta="category:Marketing">
    <header class="section-wrapper texture-607">
      <section class="section intro-section">
        <h1 class="heading-1">Interactive Demos</h1>
        <p class="subtitle">Subsurface and BIM Data Visualizations</p>
        <p class="paragraph-xl">
          Explore real-world examples of subsurface and BIM data across
          different platforms. See ground investigation data in CesiumJS 3D
          maps, MapLibre, and Speckle. For free browser apps you can run on your
          own files, see our <a class="link" href="/tools">tools</a>.
        </p>
      </section>
    </header>

    <div class="section-wrapper texture-616">
      <section class="section">
        <div class="filter-bar" role="group" aria-label="Filter demos">
          {
            tagDimensions.map((dim) => (
              <div class="filter-row">
                <span class="filter-label">{dim.label}</span>
                <div class="filter-chips">
                  {availableTags[dim.key].map((value) => (
                    <button
                      type="button"
                      class="filter-chip"
                      data-dim={dim.key}
                      data-value={value}
                      aria-pressed="false"
                    >
                      {value}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
          <button type="button" class="reset-filters" hidden>
            Reset filters
          </button>
        </div>

        <div class="grid-auto-fit demos-grid">
          {demoItems.map((demo) => <DemoCard {...demo} />)}
        </div>

        <div class="demos-empty" hidden>
          <h3 class="heading-3">No demos match these filters yet.</h3>
          <p class="paragraph">
            Looking for something specific? <Link
              href="https://cal.com/bedrock.engineer"
              >Schedule a Discovery Call</Link
            > or <Link href="mailto:info@bedrock.engineer">email us</Link>.
          </p>
        </div>
      </section>
    </div>

    <div class="section-wrapper texture-616">
      <section class="section cta-section">
        <h2
          class="heading-2"
          style="text-align: center; margin-block-end: 16px;"
        >
          Want to see your ground investigation data visualized?
        </h2>
        <p
          class="paragraph"
          style="text-align: center; margin-block-end: 32px; color: var(--gray-11);"
        >
          We build custom visualizations and web applications for subsurface
          data.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a
            href="https://cal.com/bedrock.engineer"
            class="cta-button"
            target="_blank"
          >
            Schedule Discovery Call
          </a>
          <a href="/services" class="cta-button-secondary">
            View Our Services
          </a>
        </div>
      </section>
    </div>
  </div>

  <Footer />

  <script>
    const dims = ["country", "type", "sourceData", "gm"] as const;
    type Dim = (typeof dims)[number];

    const filters: Record<Dim, Set<string>> = {
      country: new Set(),
      type: new Set(),
      sourceData: new Set(),
      gm: new Set(),
    };

    function readFromUrl() {
      const params = new URLSearchParams(window.location.search);
      for (const dim of dims) {
        filters[dim] = new Set(params.getAll(dim));
      }
    }

    function writeToUrl() {
      const p = new URLSearchParams();
      for (const dim of dims) {
        for (const v of filters[dim]) p.append(dim, v);
      }
      const qs = p.toString();
      history.replaceState(null, "", qs ? `?${qs}` : window.location.pathname);
    }

    function cardMatches(card: HTMLElement) {
      for (const dim of dims) {
        const active = filters[dim];
        if (active.size === 0) continue;
        const raw = card.dataset[dim] || "";
        const cardTags = raw.split(",").filter(Boolean);
        const matched = [...active].some((v) => cardTags.includes(v));
        if (!matched) return false;
      }
      return true;
    }

    function applyFilters() {
      const cards = document.querySelectorAll<HTMLElement>(
        ".demos-grid .demo-card[data-demo-id]",
      );
      const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
      const resetBtn =
        document.querySelector<HTMLButtonElement>(".reset-filters");
      const grid = document.querySelector<HTMLElement>(".demos-grid");
      const empty = document.querySelector<HTMLElement>(".demos-empty");

      const update = () => {
        let visible = 0;
        cards.forEach((card) => {
          const m = cardMatches(card);
          card.style.display = m ? "" : "none";
          if (m) visible++;
        });
        chips.forEach((chip) => {
          const dim = chip.dataset.dim as Dim;
          const value = chip.dataset.value || "";
          const active = filters[dim].has(value);
          chip.classList.toggle("active", active);
          chip.setAttribute("aria-pressed", String(active));
        });
        const anyActive = dims.some((d) => filters[d].size > 0);
        if (resetBtn) resetBtn.hidden = !anyActive;
        if (empty) empty.hidden = visible > 0;
        if (grid) grid.hidden = visible === 0;
      };

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (
        "startViewTransition" in document &&
        typeof document.startViewTransition === "function" &&
        !reduced
      ) {
        document.startViewTransition(update);
      } else {
        update();
      }
    }

    function init() {
      readFromUrl();

      document
        .querySelectorAll<HTMLButtonElement>(".filter-chip")
        .forEach((chip) => {
          chip.addEventListener("click", () => {
            const dim = chip.dataset.dim as Dim;
            const value = chip.dataset.value || "";
            if (filters[dim].has(value)) filters[dim].delete(value);
            else filters[dim].add(value);
            writeToUrl();
            applyFilters();
          });
        });

      document
        .querySelector<HTMLButtonElement>(".reset-filters")
        ?.addEventListener("click", () => {
          for (const dim of dims) filters[dim].clear();
          writeToUrl();
          applyFilters();
        });

      applyFilters();
    }

    init();
  </script>
</BaseLayout>

<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block-end: var(--space-m);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: var(--font-condensed);
    font-weight: var(--font-semibold);
    color: var(--gray-11);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex: 0 0 auto;
    min-width: 5.5rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .filter-chip {
    appearance: none;
    background: transparent;
    color: var(--gray-12);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 2px 10px;
    font-size: var(--text-xs);
    font-family: inherit;
    line-height: 1.5;
    cursor: pointer;

    @media (prefers-reduced-motion: no-preference) {
      transition:
        background 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    }
  }

  .filter-chip:hover {
    border-color: var(--green-7);
  }

  .filter-chip:focus-visible {
    outline: 2px solid var(--green-9);
    outline-offset: 2px;
  }

  .filter-chip.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .reset-filters {
    align-self: flex-start;
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin-block-start: var(--space-3xs);
    color: var(--green-9);
    cursor: pointer;
    font-weight: var(--font-semibold);
    font-size: var(--text-xs);
    text-decoration: underline;
    font-family: inherit;
  }

  .reset-filters:hover {
    color: var(--green-10);
  }

  .reset-filters:focus-visible {
    outline: 2px solid var(--green-9);
    outline-offset: 2px;
  }

  .demos-empty {
    text-align: center;
    padding: var(--space-2xl) var(--space-m);
  }

  .demos-empty .heading-3 {
    margin-block-end: var(--space-s);
  }
</style>

