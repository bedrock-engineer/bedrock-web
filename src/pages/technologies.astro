---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
import Link from "../components/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/custom.css";

const title =
  "Geotechnical Software Development Capabilities - CesiumJS, AGS4, GEF, Speckle | Bedrock.engineer";
const description =
  "Software consultancy specializing in CesiumJS development, AGS4/GEF parsing, Speckle connectors, and Python geospatial tools for geotechnical engineering data. Expert developers for subsurface visualization and data transformation.";
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href="https://bedrock.engineer/technologies" />

    <meta
      name="keywords"
      content="CesiumJS developer, CesiumJS development, AGS4 parser, AGS3 parser, geotechnical exchange format, bro/xml, GEF parser, BRO XML parser, Speckle connector development, Python geospatial developer, GeoPandas developer, geotechnical software development, subsurface data visualization, borehole data processing, CPT data visualization, Three.js geological visualization, ground investigation software, geotechnical data transformation, PostGIS geotechnical, Rhino Grasshopper geotechnical, MapLibre GL subsurface, Deck.gl geotechnical"
    />

    <!-- Open Graph -->
    <meta property="og:url" content="https://bedrock.engineer/technologies" />
    <meta property="og:site_name" content="Bedrock.engineer" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Author & Robots directives -->
    <meta name="author" content="Bedrock.engineer" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  </Fragment>

  <!-- Structured Data for Services -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "Bedrock.engineer Software Consultancy",
      description:
        "Software consultancy for subsurface data transformation, visualization, and integration",
      serviceType: [
        "Geotechnical Software Development",
        "CesiumJS Development",
        "AGS4 Data Processing",
        "Speckle Connectors",
        "Python Geospatial Development",
      ],
      areaServed: "Worldwide",
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Geotechnical Software Services",
        itemListElement: [
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "CesiumJS 3D Visualization Development",
              description:
                "Custom CesiumJS applications for subsurface and geological data visualization",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "AGS3 & AGS4 Data Processing",
              description:
                "Parse and transform AGS3 or AGS4 geotechnical data formats into modern geospatial data",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "BRO/XML & GEF Data Processing",
              description:
                "Parse and transform BRO/XML & GEF geotechnical data formats into modern geospatial data",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Python Geospatial Development for subsurface data",
              description:
                "Custom ground investigation data pipelines using GeoPandas, Shapely, and modern Python geospatial tools",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Speckle Connector Development",
              description:
                "Custom Speckle connectors for geotechnical data integration with BIM and CAD tools",
            },
          },
        ],
      },
    })}
  />

  <!-- BreadcrumbList Schema for page hierarchy -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://bedrock.engineer",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Technologies",
          item: "https://bedrock.engineer/technologies",
        },
      ],
    })}
  />

  <Navbar />
  <div class="page" data-pagefind-body data-pagefind-meta="category:Marketing">
    <header class="section-wrapper texture-607">
      <section class="section intro-section">
        <h1 class="heading-1">What We Work With</h1>
        <p class="paragraph-xl">
          We specialize in the missing middle ground between geotechnical
          formats and modern (geospatial) development. That means reading AGS4,
          GEF, and BRO/XML files, transforming them into proper geospatial data,
          and building the tools to actually use it. Such as 3D visualizations
          in CesiumJS, integrations with Revit or Civil3D through Speckle, or
          custom web applications to visualize your subsurface data.
        </p>
      </section>
    </header>

    <!-- Data Ingestion -->
    <div class="section-wrapper texture-667">
      <section class="section">
        <h2 class="heading-2" style="margin-block-end: var(--space-l);">
          Reading Your Ground Investigation Data
        </h2>

        <div class="grid-auto-fit">
          <Card size="medium">
            <h3 class="heading-3">Industry GI Formats</h3>
            <p class="tech-subtitle">AGS3, AGS4, GEF, BRO/XML</p>
            <p class="card-text">
              We can process specialized formats that ground investigation data
              comes in, like AGS3, AGS4, GEF files with CPT and borehole data,
              or BRO/XML from the Dutch subsurface registry. We parse these
              formats, structure the data, and can convert them into geospatial
              data.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Spreadsheets & Semi-structured Data</h3>
            <p class="tech-subtitle">Excel, CSV</p>
            <p class="card-text">
              In practice, not all ground investigation data follows a standard.
              We can handle the Excel spreadsheets with custom schemas, CSVs
              with inconsistent formatting.
            </p>
          </Card>
        </div>
      </section>
    </div>

    <!-- Data Processing & Analysis -->
    <div class="section-wrapper texture-620">
      <section class="section">
        <h2 class="heading-2" style="margin-block-end: var(--space-l);">
          Processing & Storage
        </h2>

        <div class="grid-auto-fit">
          <Card>
            <h3 class="heading-3">Geospatial Data Pipelines</h3>
            <p class="tech-subtitle">GeoPandas, Shapely, Pandas</p>
            <p class="card-text">
              The foundation of our <a
                href="https://github.com/bedrock-engineer/bedrock-ge/"
                class="link">bedrock-ge</a
              >
              library is built using Python's geospatial ecosystem. We use GeoPandas
              to build data pipelines that transform AGS4, GEF, or BRO/XML files into
              proper geospatial data with coordinate systems, validation, and relationships
              between boreholes, samples, and test results intact.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Spatial Database</h3>
            <p class="tech-subtitle">PostGIS, PostgreSQL</p>
            <p class="card-text">
              Centralized database for ground investigation data instead of
              scattered files. PostgreSQL with PostGIS handles spatial queries
              on borehole locations, CPT tests, and geological boundaries. Load
              AGS4, GEF, or BRO data once, query from QGIS, ArcGIS, FME, or web
              applications.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Rhino3D & Grasshopper</h3>
            <p class="tech-subtitle">Parametric Design, Python Scripting</p>
            <p class="card-text">
              Bring subsurface data into Grasshopper. Custom components to read
              and visualize ground investigation data, generate ground models,
              run geotechnical calculations, or integrate soil layering into
              parametric designs.
            </p>
          </Card>
        </div>
      </section>
    </div>

    <!-- Visualization -->
    <div class="section-wrapper texture-607">
      <section class="section">
        <h2 class="heading-2" style="margin-block-end: var(--space-l);">
          Visualization
        </h2>

        <h3 class="heading-3" style="margin-block-end: var(--space-m);">
          Geospatial & Web Maps
        </h3>
        <div class="grid-auto-fit" style="margin-block-end: var(--space-xl);">
          <Card size="medium">
            <h3 class="heading-3">CesiumJS</h3>
            <p class="tech-subtitle">3D Web Globes, Digital Twins, 3D Tiles</p>
            <p class="card-text">
              Browser-based 3D visualization of subsurface data on interactive
              globes. Place boreholes, CPT locations, and geological features in
              their real-world context with terrain, imagery, and building
              models. Stream large datasets efficiently with 3D Tiles.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Volumetric Geological Models</h3>
            <p class="tech-subtitle">3D Tiles Voxels, NetCDF</p>
            <p class="card-text">
              Volumetric visualization of geological models in the browser using
              the 3D Tiles Voxel extension. Convert netCDF, structured grids, or
              geological block models into streamable web format. Render
              subsurface uncertainty, property distributions, or stratigraphic
              models at scale in the browser.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Interactive Web Maps</h3>
            <p class="tech-subtitle">MapLibre GL, Deck.gl, PMTiles</p>
            <p class="card-text">
              Interactive 2D and 3D web maps. MapLibre GL for vector tiles,
              Deck.gl for WebGL layers. Render thousands of boreholes and CPT
              locations with interactive filters. PMTiles for cloud-optimized
              serving without a tile server.
            </p>
          </Card>
        </div>

        <h3 class="heading-3" style="margin-block-end: var(--space-m);">
          3D Visualization
        </h3>
        <div class="grid-auto-fit" style="margin-block-end: var(--space-xl);">
          <Card size="medium">
            <h3 class="heading-3">Custom 3D Visualization</h3>
            <p class="tech-subtitle">Three.js, WebGL</p>
            <p class="card-text">
              Custom 3D visualizations for subsurface data. Borehole renderings,
              geological cross-sections, and underground models with full
              control over materials, lighting, and interaction.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Scientific Visualization</h3>
            <p class="tech-subtitle">PyVista, ParaView</p>
            <p class="card-text">
              Scientific visualization with PyVista and ParaView.
              Publication-quality cross-sections, volumetric renderings, and
              analysis workflows for subsurface data.
            </p>
          </Card>
        </div>

        <h3 class="heading-3" style="margin-block-end: var(--space-m);">
          Charts & Dashboards
        </h3>
        <div class="grid-auto-fit">
          <Card size="medium">
            <h3 class="heading-3">Technical Charts & Diagrams</h3>
            <p class="tech-subtitle">D3.js, Observable Plot</p>
            <p class="card-text">
              Custom interactive charts for technical data. Borehole logs, CPT
              plots, soil classification diagrams, and domain-specific
              visualizations using SVG and web standards.
            </p>
          </Card>

          <Card size="small">
            <h3 class="heading-3">Interactive Dashboards</h3>
            <p class="tech-subtitle">Plotly, Dash</p>
            <p class="card-text">
              Interactive charts and dashboards. Plotly for technical plots,
              Dash for Python web applications. Data exploration and reporting
              interfaces.
            </p>
          </Card>

          <Card size="small">
            <h3 class="heading-3">Power BI Custom Visuals</h3>
            <p class="tech-subtitle">
              Business Intelligence, Geotechnical Charts
            </p>
            <p class="card-text">
              Custom Power BI plugins for subsurface data. Borehole logs, CPT
              plots, and geotechnical charts in BI dashboards.
            </p>
          </Card>
        </div>
      </section>
    </div>

    <!-- Integration & Export -->
    <div class="section-wrapper texture-616">
      <section class="section">
        <h2 class="heading-2" style="margin-block-end: var(--space-l);">
          Integration & Export
        </h2>

        <div class="grid-auto-fit">
          <Card size="medium">
            <h3 class="heading-3">BIM/CAD Integration</h3>
            <p class="tech-subtitle">Speckle, Revit, Civil3D</p>
            <p class="card-text">
              Connect geotechnical data with Revit, Civil3D, Rhino3D, and other
              design tools through Speckle. Custom connectors and objects for
              AGS4 boreholes, CPT data, and geological models. Stream subsurface
              data to design teams with live updates when ground investigation
              data changes.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Geospatial Formats</h3>
            <p class="tech-subtitle">GeoPackage, GeoParquet, GeoJSON</p>
            <p class="card-text">
              Export GI data to geospatial formats for GIS workflows. GeoPackage
              for QGIS and ArcGIS, GeoParquet for cloud-optimized analysis,
              GeoJSON for web applications. Convert AGS4, GEF, or BRO data to
              formats that work with standard GIS tools.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Scientific Data Formats</h3>
            <p class="tech-subtitle">NetCDF, Zarr</p>
            <p class="card-text">
              Export 3D subsurface models to scientific data formats. NetCDF and
              Zarr for volumetric geological models, property distributions, and
              gridded subsurface data. Cloud-native formats for large-scale
              analysis.
            </p>
          </Card>

          <Card size="medium">
            <h3 class="heading-3">Custom Web Applications</h3>
            <p class="tech-subtitle">HTML, CSS, React, Svelte, TypeScript</p>
            <p class="card-text">
              Custom web applications for geotechnical data. Interactive
              interfaces for displaying GI data in maps, borehole logs, CPT
              charts, cross-sections. Built with modern frameworks for
              usability, performance and maintainability.
            </p>
          </Card>

          <Card size="small">
            <h3 class="heading-3">IFC</h3>
            <p class="tech-subtitle">BIM Data Exchange, geotechnical BIM</p>
            <p class="card-text">
              Export geotechnical data to Industry Foundation Classes (IFC)
              format for BIM workflows and integration with BIM software.
            </p>
          </Card>
        </div>
      </section>
    </div>

    <!-- CTA Section -->
    <div class="section-wrapper texture-620">
      <section class="section cta-section">
        <h2
          class="heading-3"
          style="text-align: center; margin-block-end: 16px;"
        >
          Ready to apply these technologies to your project?
        </h2>
        <p
          class="paragraph"
          style="text-align: center; margin-block-end: 32px; color: var(--gray-11);"
        >
          We develop custom solutions for geotechnical data transformation, 3D
          visualization, and BIM/CAD integration.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="https://cal.com/bedrock-engineer" class="cta-button">
            Schedule Discovery Call
          </a>
          <a href="/services" class="cta-button-secondary">
            View Our Services
          </a>
        </div>
      </section>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .tech-subtitle {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--green-8);
    margin-block-start: calc(-1 * var(--space-2xs));
    margin-block-end: var(--space-2xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-text {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--gray-12);
    margin: 0;
  }
</style>
