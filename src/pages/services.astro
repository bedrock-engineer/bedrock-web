---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import "../styles/custom.css";

const title =
  "Software Development Services for Geotechnical Data | Bedrock.engineer";
const description =
  "Custom software development for transforming geotechnical data, building 3D web maps, and integrating subsurface data with CAD, BIM, and design tools.";
---

<BaseLayout title={title} description={description}>
  <Navbar />
  <div class="page" data-pagefind-body data-pagefind-meta="category:Marketing">
    <!-- Hero Section -->
    <header class="section-wrapper texture-607">
      <section class="section intro-section">
        <h1 class="heading-1">Software Development for Geotechnical Data</h1>
        <p class="paragraph-xl" style="margin-block-end: 32px;">
          We build custom tools and workflows that bridge the gap between (legacy)
          geotechnical formats and modern software, from digital twins for
          policy makers to specialized web viewers for engineering teams.
        </p>
        <div class="flex gap-4 flex-wrap">
          <a href="https://cal.com/bedrock.engineer" class="cta-button">
            Schedule Discovery Call
          </a>
          <a href="mailto:info@bedrock.engineer" class="cta-button-secondary">
            Email Us
          </a>
        </div>
      </section>
    </header>

    <!-- Services Grid -->
    <div class="section-wrapper texture-232-k">
      <section class="section">
        <h2
          class="heading-3"
          style="margin-block-end: 48px; text-align: center;"
        >
          Our Services
        </h2>

        <div class="services-grid">
          <!-- Data Transformation -->
          <Card>
            <h3 class="service-title">Data Transformation & Structuring</h3>
            <p class="service-description">
              Transform industry-specific formats (AGS3/4, GEF, <a
                class="link"
                href="/nl/bro-xml">BRO/XML</a
              >) into modern geospatial standards.
            </p>
            <div class="service-details">
              <h4 class="service-details-title">Typical deliverables:</h4>
              <ul class="service-list">
                <li>Transformation scripts and workflows</li>
                <li>Cleaned and validated ground investigation datasets</li>
              </ul>
            </div>
            <div class="service-meta">
              <strong>Examples:</strong> Set up PostGIS databases when a team needs
              a centralized, editable geospatial data or GeoPackage for finalized
              data handoff
            </div>
          </Card>

          <!-- Web Apps & Maps -->
          <Card>
            <h3 class="service-title">Web Applications & Data Visualization</h3>
            <p class="service-description">
              Interactive web applications for exploring GI data in the browser:
              CPT tools, 3D map viewers (CesiumJS), viewers for analysis models
              (Plaxis, Deltares D-Series) and geological models (Leapfrog), and
              custom charts.
            </p>
            <div class="service-details">
              <h4 class="service-details-title">Typical deliverables:</h4>
              <ul class="service-list">
                <li>Deployed web application</li>
                <li>Source code and documentation</li>
                <li>Hosting setup and support</li>
              </ul>
            </div>
            <div class="service-meta">
              <strong>Examples:</strong> CPT data browser for organizing and comparing
              soundings, web viewer for FEM/geological models with context, or interactive
              3D map viewer with subsurface layers
            </div>
          </Card>

          <!-- Digital Twins -->
          <Card>
            <h3 class="service-title">Digital Twins for Infrastructure</h3>
            <p class="service-description">
              Create digital twin environments that integrate subsurface data
              with infrastructure assets. Give policy makers and stakeholders
              interactive tools to explore geotechnical and geological data in
              spatial context alongside planning and design information.
            </p>
            <div class="service-details">
              <h4 class="service-details-title">Typical deliverables:</h4>
              <ul class="service-list">
                <li>Web-based digital twin platform</li>
                <li>Integrated geotechnical and infrastructure data</li>
                <li>
                  Shareable views for reviews, presentations, or public pages
                </li>
              </ul>
            </div>
            <div class="service-meta">
              <strong>Good for:</strong> Municipal planning, infrastructure management,
              and public engagement.
            </div>
          </Card>

          <!-- CAD/BIM Integration -->
          <Card>
            <h3 class="service-title">CAD/BIM/Design Integration</h3>
            <p class="service-description">
              Bring subsurface context into your design process. Connect
              geotechnical data to Rhino3D/Grasshopper, Revit, Civil3D, or other
              design tools.
            </p>
            <div class="service-details">
              <h4 class="service-details-title">Typical deliverables:</h4>
              <ul class="service-list">
                <li>Custom connectors and plugins</li>
                <li>Automated workflows</li>
                <li>Integration documentation</li>
              </ul>
            </div>
            <div class="service-meta">
              <strong>Good for:</strong> Geotechnical engineers, designers, and BIM
              coordinators who need ground data inside their existing design file.
            </div>
          </Card>

          <!-- Custom Development -->
          <Card>
            <h3 class="service-title">Custom Development</h3>
            <p class="service-description">
              Tools and workflows tailored to your challenges, from automation
              scripts to full applications.
            </p>
            <div class="service-details">
              <h4 class="service-details-title">Typical deliverables:</h4>
              <ul class="service-list">
                <li>Custom software and tools</li>
                <li>Automation scripts</li>
                <li>Open-source contributions</li>
              </ul>
            </div>
            <div class="service-meta">
              <strong>Good for:</strong> Work where off-the-shelf tools fall short,
              built to match your data and workflow, not the other way around.
            </div>
          </Card>
        </div>

        <!-- <div style="margin-top: 48px; text-align: center;">
          <a href="/cases/" class="section-link">
            View examples of our work →
          </a>
        </div> -->
      </section>
    </div>

    <!-- How We Work -->
    <div class="section-wrapper texture-620">
      <section class="section">
        <h2
          class="heading-3"
          style="margin-block-end: 48px; text-align: center;"
        >
          How We Work
        </h2>

        <ol class="process-timeline">
          <li class="process-step">
            <div>
              <h3 class="process-title">Discovery Call</h3>
              <p class="process-description">
                We talk through your data, how you work with it now, and what
                you'd like to change. By the end, both sides know whether it's
                worth continuing.
              </p>
            </div>
          </li>

          <li class="process-step">
            <div>
              <h3 class="process-title">Scoping & Proposal</h3>
              <p class="process-description">
                Together we define clear deliverables, timeline, and budget.
              </p>
            </div>
          </li>

          <li class="process-step">
            <div>
              <h3 class="process-title">Development</h3>
              <p class="process-description">
                We build iteratively with regular check-ins and demos. You stay
                involved and can provide feedback throughout.
              </p>
            </div>
          </li>

          <li class="process-step">
            <div>
              <h3 class="process-title">Delivery & Handoff</h3>
              <p class="process-description">
                We deliver complete documentation, provide training if needed,
                and make sure you can run and maintain what we built.
              </p>
            </div>
          </li>
        </ol>
      </section>
    </div>

    <div class="section-wrapper texture-607">
      <section class="section">
        <h2
          class="heading-3"
          style="margin-block-end: 48px; text-align: center;"
        >
          Why Bedrock.engineer
        </h2>

        <div class="grid-auto-fit-narrow">
          <Card>
            <h3 class="value-title">Open-source at heart</h3>
            <p class="value-description">
              No vendor lock-in. Tools you can inspect, modify, and own. Our
              core library <code>bedrock-ge</code> is open-source.
            </p>
          </Card>

          <Card>
            <h3 class="value-title">Dual expertise</h3>
            <p class="value-description">
              We understand both geotechnical engineering and modern software
              development, so you don't have to translate between the two.
            </p>
          </Card>

          <Card>
            <h3 class="value-title">Modern stack</h3>
            <p class="value-description">
              Built for interoperability with Python, web standards, and
              geospatial tools. Your data works with the tools you already use.
            </p>
          </Card>
        </div>
      </section>
    </div>

    <!-- CTA Section -->
    <div class="section-wrapper texture-616">
      <section class="section cta-section">
        <h2
          class="heading-2"
          style="text-align: center; margin-block-end: 16px;"
        >
          Let's discuss
        </h2>
        <p
          class="paragraph"
          style="text-align: center; margin-block-end: 32px; color: var(--gray-11);"
        >
          Book a call to talk through your data, your current workflow, or what
          you'd like to build. Or send us an email.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="https://cal.com/bedrock.engineer" class="cta-button">
            Schedule Discovery Call
          </a>
          <a href="mailto:info@bedrock.engineer" class="cta-button-secondary">
            Email Us
          </a>
        </div>
      </section>
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .service-icon {
    color: var(--green-9);
    margin-block-end: 16px;
  }

  .service-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-block-end: 12px;
    color: var(--gray-12);
  }

  .service-description {
    font-size: var(--text-base);
    line-height: 1.6;
    margin-block-end: 20px;
    color: var(--gray-11);
  }

  .service-details {
    margin-block-end: 16px;
  }

  .service-details-title {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-block-end: 8px;
    color: var(--gray-12);
  }

  .service-list {
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--gray-11);
  }

  .service-list li {
    padding-inline-start: 20px;
    position: relative;
    margin-block-end: 4px;
  }

  .service-list li::before {
    content: "•";
    position: absolute;
    left: 8px;
    color: var(--green-9);
  }

  .service-meta {
    font-size: var(--text-sm);
    padding: 12px;
    background: var(--gray-3);
    border-radius: var(--border-radius-sm);
    color: var(--gray-11);
  }

  .service-meta strong {
    color: var(--gray-12);
  }

  /* Process Timeline */
  .process-timeline {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    list-style: none;
    padding: 0;
    counter-reset: process-counter;
  }

  .process-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 24px;
    align-items: start;
    counter-increment: process-counter;
  }

  .process-step::before {
    content: counter(process-counter);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--green-9);
    color: white;
    display: grid;
    place-content: center;
    font-size: 24px;
    font-weight: 600;
    align-self: center;
  }

  .process-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-block-end: 8px;
    color: var(--gray-12);
  }

  .process-description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--gray-11);
    max-width: 60ch;
  }

  /* Values Grid - now using .grid-auto-fit-narrow from global CSS */

  .value-icon {
    color: var(--green-9);
    margin-block-end: 16px;
  }

  .value-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-block-end: 12px;
    color: var(--gray-12);
  }

  .value-description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--gray-11);
  }

  .value-description code {
    background: var(--gray-3);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9em;
  }

  /* CTA Section */
  .cta-section {
    padding-block: 64px;
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .process-step {
      grid-template-columns: 50px 1fr;
      gap: 16px;
    }

    .process-step::before {
      width: 50px;
      height: 50px;
      font-size: 20px;
    }
  }
</style>
