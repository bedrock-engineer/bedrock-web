{
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$description": "Badges, small floating chips.",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.25 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 4, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$type": "shadow",
      "$description": "Dropdowns, mobile nav panel.",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "lg": {
      "$type": "shadow",
      "$description": "Modals, prominent overlays.",
      "$value": {
        "color": "{color.shadow-strong}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 10, "unit": "px" },
        "blur": { "value": 25, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  }
}
