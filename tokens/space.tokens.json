      "$value": {
        "value": 0.94,
        "unit": "rem"
      },
      "$extensions": {
        "engineer.bedrock.css": {
          "value": "clamp(0.75rem, 0.69rem + 0.28vw, 0.94rem)",
          "min": "0.75rem",
          "max": "0.94rem"
        }
      }
