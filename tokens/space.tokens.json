{
  "space": {
    "$description": "Utopia-style fluid space scale (375px \u2192 1440px). $value is the desktop max; the CSS build emits the clamp() from $extensions.",
    "3xs": {
      "$type": "dimension",
      "$value": {
        "value": 0.31,
        "unit": "rem"
      },
      "$extensions": {
        "engineer.bedrock.css": {
          "value": "clamp(0.25rem, 0.23rem + 0.09vw, 0.31rem)",
          "min": "0.25rem",
          "max": "0.31rem"
        }
      }
    },
    "2xs": {
      "$type": "dimension",
      "$value": {
        "value": 0.63,
        "unit": "rem"
      },
      "$extensions": {
        "engineer.bedrock.css": {
          "value": "clamp(0.5rem, 0.46rem + 0.19vw, 0.63rem)",
          "min": "0.5rem",
          "max": "0.63rem"
        }
      }
    },
    "xs": {
